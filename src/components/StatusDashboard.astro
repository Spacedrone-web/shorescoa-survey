---
import DEDICATED from "../lib/dedicated.json";

// ICONS
const ICONS = {
  parking: "🚗",
  checkin: "📅",
  studio: "🏢",
  one: "1️⃣",
  two: "2️⃣",
  three: "3️⃣"
};

const env = (Astro.locals as any).runtime?.env ?? {};
const DB = env.DB;

if (!DB) throw new Error("DB binding not available");

// Stack → type
const STACK_MAP = {
  "01": "3 Bedroom","02": "1 Bedroom","03": "2 Bedroom","04": "2 Bedroom",
  "05": "Studio","06": "Studio","07": "2 Bedroom","08": "1 Bedroom",
  "09": "1 Bedroom","10": "2 Bedroom","11": "1 Bedroom","12": "1 Bedroom",
  "13": "1 Bedroom","14": "1 Bedroom","15": "1 Bedroom","16": "1 Bedroom",
  "17": "1 Bedroom","18": "2 Bedroom","19": "2 Bedroom","20": "2 Bedroom",
  "21": "2 Bedroom","22": "2 Bedroom","23": "2 Bedroom","24": "2 Bedroom",
  "25": "1 Bedroom","26": "1 Bedroom","27": "1 Bedroom","28": "3 Bedroom",
  "29": "2 Bedroom","30": "1 Bedroom","31": "3 Bedroom"
};

const TOTAL = {
  "Studio": 41,
  "1 Bedroom": 292,
  "2 Bedroom": 231,
  "3 Bedroom": 61
};

const ALLOWED = {
  "Studio": 1,
  "1 Bedroom": 1,
  "2 Bedroom": 2,
  "3 Bedroom": 2
};

// Rentals (all active today)
const currentRentals = await DB.prepare(`
  SELECT unit, arrival, departure, createdAt
  FROM guests
  WHERE arrival <= date('now') AND departure >= date('now')
`).all();

// Helper: parse unit → number + type
function parseUnit(raw) {
  if (!raw) return { unitNum: null, type: null };
  const base = raw.split(" ")[0];
  const unitNum = parseInt(base, 10);
  if (Number.isNaN(unitNum)) return { unitNum: null, type: null };
  const stack = base.slice(-2).padStart(2, "0");
  return { unitNum, type: STACK_MAP[stack] ?? null };
}

// Count rentals by type + yellow usage
const rentedByType = {
  "Studio": 0,
  "1 Bedroom": 0,
  "2 Bedroom": 0,
  "3 Bedroom": 0
};

let yellowUsed = 0;
const yellowTotal = 274;

for (const row of currentRentals.results ?? []) {
  const { unitNum, type } = parseUnit(row.unit);
  if (!type || !unitNum) continue;

  rentedByType[type]++;

  const dedicated = DEDICATED[unitNum] ?? 0;
  const allowed = ALLOWED[type];
  yellowUsed += Math.max(0, allowed - dedicated);
}

// SAME-DAY CHECK-IN LOGIC (corrected)
const today = new Date().toISOString().slice(0,10);

// All passes arriving today
const arrivalsToday = (currentRentals.results ?? []).filter(r => {
  const arrivalISO = new Date(r.arrival).toISOString().slice(0,10);
  return arrivalISO === today;
});

// Total check-ins today
const totalToday = arrivalsToday.length;

// Same-day check-ins = arrival date matches created date
const sameDayCount = arrivalsToday.filter(r => {
  const arrivalISO = new Date(r.arrival).toISOString().slice(0,10);
  const createdISO = new Date(r.createdAt).toISOString().slice(0,10);
  return arrivalISO === createdISO;
}).length;

// Percent helper
function pct(r, t) { return t ? (r / t) * 100 : 0; }

// Percentages
const studioPct = pct(rentedByType["Studio"], TOTAL["Studio"]);
const onePct = pct(rentedByType["1 Bedroom"], TOTAL["1 Bedroom"]);
const twoPct = pct(rentedByType["2 Bedroom"], TOTAL["2 Bedroom"]);
const threePct = pct(rentedByType["3 Bedroom"], TOTAL["3 Bedroom"]);
const yellowPct = pct(yellowUsed, yellowTotal);
const sameDayPct = pct(sameDayCount, totalToday);

// Status labels
function statusLabel(p) {
  if (p < 60) return "Low";
  if (p < 85) return "Moderate";
  return "High";
}

// Status color
function statusColor(p) {
  if (p < 60) return "#22c55e"; // green
  if (p < 85) return "#eab308"; // yellow
  return "#ef4444"; // red
}

// Trend arrows (simple logic)
function trendArrow(p) {
  if (p < 60) return "⬆️";
  if (p < 85) return "➡️";
  return "⬇️";
}

// Mini sparkline (last 7 days)
const last7 = await DB.prepare(`
  SELECT arrival
  FROM guests
  WHERE arrival >= date('now','-7 days')
    AND arrival <= date('now')
`).all();

function sparkline() {
  const arr = Array(7).fill(0);
  for (const r of last7.results ?? []) {
    const idx = 6 - Math.floor((new Date(today) - new Date(r.arrival)) / 86400000);
    if (idx >= 0 && idx < 7) arr[idx]++;
  }
  return arr.map(v => "▇".repeat(Math.min(v, 5)) || "▁").join(" ");
}
---

<style>
  .card {
    background:#1f2937;
    border-radius:10px;
    padding:16px;
    color:#f9fafb;
    box-shadow:0 2px 6px rgba(0,0,0,0.25);
    transition:transform 0.15s ease;
  }
  .card:hover {
    transform:translateY(-3px);
  }
  .bar {
    height:8px;
    border-radius:4px;
    background:#374151;
    overflow:hidden;
    margin:8px 0;
  }
  .bar-fill {
    height:100%;
    border-radius:4px;
  }
</style>

<div style="margin-top: 1.5rem;">
  <p style="margin-bottom: 1rem; color:#9ca3af;">
    Status as of {new Date().toLocaleString("en-US", { timeZone: "America/Denver" })}
  </p>

  <div
    style="
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    "
  >

    <!-- YELLOW PARKING -->
    <div class="card">
      <div style="font-size:20px; font-weight:700;">{ICONS.parking} Yellow Parking</div>
      <div style="font-size:26px; font-weight:700;">{yellowUsed}/{yellowTotal}</div>
      <div class="bar">
        <div class="bar-fill" style="width:{yellowPct}%; background:{statusColor(yellowPct)};"></div>
      </div>
      <div>Usage: {yellowPct.toFixed(1)}%</div>
      <div>Status: <span style="color:{statusColor(yellowPct)};">{statusLabel(yellowPct)}</span> {trendArrow(yellowPct)}</div>
      <div style="color:#9ca3af; font-size:12px;">Yellow spaces in use</div>
      <div style="margin-top:8px; font-size:12px;">7‑day trend: {sparkline()}</div>
    </div>

    <!-- SAME-DAY CHECKINS -->
    <div class="card">
      <div style="font-size:20px; font-weight:700;">{ICONS.checkin} Same-Day Check-ins</div>
      <div style="font-size:26px; font-weight:700;">{sameDayCount}/{totalToday}</div>
      <div class="bar">
        <div class="bar-fill" style="width:{sameDayPct}%; background:{statusColor(sameDayPct)};"></div>
      </div>
      <div>Ratio: {sameDayPct.toFixed(1)}%</div>
      <div>Status: <span style="color:{statusColor(sameDayPct)};">{statusLabel(sameDayPct)}</span> {trendArrow(sameDayPct)}</div>
      <div style="color:#9ca3af; font-size:12px;">Arrival date matches created date</div>
      <div style="margin-top:8px; font-size:12px;">7‑day trend: {sparkline()}</div>
    </div>

    <!-- STUDIOS -->
    <div class="card">
      <div style="font-size:20px; font-weight:700;">{ICONS.studio} Studios</div>
      <div style="font-size:26px; font-weight:700;">{rentedByType["Studio"]}/{TOTAL["Studio"]}</div>
      <div class="bar">
        <div class="bar-fill" style="width:{studioPct}%; background:{statusColor(studioPct)};"></div>
      </div>
      <div>Occupancy: {studioPct.toFixed(1)}%</div>
      <div>Status: <span style="color:{statusColor(studioPct)};">{statusLabel(studioPct)}</span> {trendArrow(studioPct)}</div>
      <div style="color:#9ca3af; font-size:12px;">Rented / Available</div>
      <div style="margin-top:8px; font-size:12px;">7‑day trend: {sparkline()}</div>
    </div>

    <!-- 1 BEDROOM -->
    <div class="card">
      <div style="font-size:20px; font-weight:700;">{ICONS.one} 1 Bedroom</div>
      <div style="font-size:26px; font-weight:700;">{rentedByType["1 Bedroom"]}/{TOTAL["1 Bedroom"]}</div>
      <div class="bar">
        <div class="bar-fill" style="width:{onePct}%; background:{statusColor(onePct)};"></div>
      </div>
      <div>Occupancy: {onePct.toFixed(1)}%</div>
      <div>Status: <span style="color:{statusColor(onePct)};">{statusLabel(onePct)}</span> {trendArrow(onePct)}</div>
      <div style="color:#9ca3af; font-size:12px;">Rented / Available</div>
      <div style="margin-top:8px; font-size:12px;">7‑day trend: {sparkline()}</div>
    </div>

    <!-- 2 BEDROOM -->
    <div class="card">
      <div style="font-size:20px; font-weight:700;">{ICONS.two} 2 Bedroom</div>
      <div style="font-size:26px; font-weight:700;">{rentedByType["2 Bedroom"]}/{TOTAL["2 Bedroom"]}</div>
      <div class="bar">
        <div class="bar-fill" style="width:{twoPct}%; background:{statusColor(twoPct)};"></div>
      </div>
      <div>Occupancy: {twoPct.toFixed(1)}%</div>
      <div>Status: <span style="color:{statusColor(twoPct)};">{statusLabel(twoPct)}</span> {trendArrow(twoPct)}</div>
      <div style="color:#9ca3af; font-size:12px;">Rented / Available</div>
      <div style="margin-top:8px; font-size:12px;">7‑day trend: {sparkline()}</div>
    </div>

    <!-- 3 BEDROOM -->
    <div class="card">
      <div style="font-size:20px; font-weight:700;">{ICONS.three} 3 Bedroom</div>
      <div style="font-size:26px; font-weight:700;">{rentedByType["3 Bedroom"]}/{TOTAL["3 Bedroom"]}</div>
      <div class="bar">
        <div class="bar-fill" style="width:{threePct}%; background:{statusColor(threePct)};"></div>
      </div>
      <div>Occupancy: {threePct.toFixed(1)}%</div>
      <div>Status: <span style="color:{statusColor(threePct)};">{statusLabel(threePct)}</span> {trendArrow(threePct)}</div>
      <div style="color:#9ca3af; font-size:12px;">Rented / Available</div>
      <div style="margin-top:8px; font-size:12px;">7‑day trend: {sparkline()}</div>
    </div>

  </div>
</div>
