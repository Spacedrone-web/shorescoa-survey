---
Astro.response.headers.set("Cache-Control", "no-cache, no-store, must-revalidate");
Astro.response.headers.set("Pragma", "no-cache");
Astro.response.headers.set("Expires", "0");

// Force SSR to operate in CST/CDT
const CST_NOW = new Date().toLocaleString("en-US", { timeZone: "America/Chicago" });
console.log("SSR CST Time:", CST_NOW);

console.log("SSR: status dashboard starting");

import StatusCard from "./StatusCard.astro";
import DEDICATED from "../lib/dedicated.json";

const env = (Astro.locals as any).runtime?.env ?? {};
const DB = env.DB;

console.log("DB binding:", !!DB);
if (!DB) throw new Error("DB binding not available");

// ---------------------------------------------------------
// LAST PIPELINE RUN
// ---------------------------------------------------------
const lastSync = await DB.prepare(`
  SELECT run_at, gathered, pushed, failed, duration_ms
  FROM pipeline_runs
  ORDER BY run_at DESC
  LIMIT 1
`).first();

// ---------------------------------------------------------
// CURRENT RENTALS (CST)
// ---------------------------------------------------------
const currentRentals = await DB.prepare(`
  SELECT unit, arrival, departure, created
  FROM guests
  WHERE arrival <= date('now','-5 hours') AND departure > date('now','-5 hours')
`).all();

// ---------------------------------------------------------
// HELPERS
// ---------------------------------------------------------
const STACK_MAP = {
  "01": "3 Bedroom","02": "1 Bedroom","03": "2 Bedroom","04": "2 Bedroom",
  "05": "Studio","06": "Studio","07": "2 Bedroom","08": "1 Bedroom",
  "09": "1 Bedroom","10": "2 Bedroom","11": "1 Bedroom","12": "1 Bedroom",
  "13": "1 Bedroom","14": "1 Bedroom","15": "1 Bedroom","16": "1 Bedroom",
  "17": "1 Bedroom","18": "2 Bedroom","19": "2 Bedroom","20": "2 Bedroom",
  "21": "2 Bedroom","22": "2 Bedroom","23": "2 Bedroom","24": "2 Bedroom",
  "25": "1 Bedroom","26": "1 Bedroom","27": "1 Bedroom","28": "3 Bedroom",
  "29": "2 Bedroom","30": "1 Bedroom","31": "3 Bedroom"
};

const TOTAL = {
  "Studio": 41,
  "1 Bedroom": 292,
  "2 Bedroom": 231,
  "3 Bedroom": 61
};

const ALLOWED = {
  "Studio": 1,
  "1 Bedroom": 1,
  "2 Bedroom": 2,
  "3 Bedroom": 2
};

function parseUnit(raw) {
  if (!raw) return { unitNum: null, type: null };
  const base = raw.split(" ")[0];
  const unitNum = parseInt(base, 10);
  if (Number.isNaN(unitNum)) return { unitNum: null, type: null };
  const stack = base.slice(-2).padStart(2, "0");
  return { unitNum, type: STACK_MAP[stack] ?? null };
}

function pct(r, t) { return t ? (r / t) * 100 : 0; }
function statusLabel(p) {
  if (p < 60) return "Low (Green)";
  if (p < 85) return "Moderate (Yellow)";
  return "High (Red)";
}
// ---------------------------------------------------------
//  Est. Total Guests 
// ---------------------------------------------------------

const today = new Date().toISOString().split("T")[0];

// const accountId = import.meta.env.CF_ACCOUNT_ID;
// const databaseId = import.meta.env.CF_D1_DB_ID;
// const apiToken = import.meta.env.CF_API_TOKEN;

const accountId = import.meta.env.CF_ACCOUNT_ID;
const databaseId = import.meta.env.CF_D1_DB_ID;
const apiToken = import.meta.env.CF_API_TOKEN;


// DEBUG: Always print these
console.log("DEBUG CF_ACCOUNT_ID:", accountId);
console.log("DEBUG CF_D1_DB_ID:", databaseId);
console.log("DEBUG CF_API_TOKEN:", apiToken ? "SET" : "NOT SET");

let todaysGuestCount = 0;

try {
  const wristbandResp = await fetch(
    `https://api.cloudflare.com/client/v4/accounts/${accountId}/d1/database/${databaseId}/query`,
    {
      method: "POST",
      headers: {
        "Authorization": `Bearer ${apiToken}`,
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        sql: "SELECT count FROM guest_wristbands WHERE date = ?",
        params: [today]
      })
    }
  ).then(r => r.json());

  todaysGuestCount =
    wristbandResp?.result?.[0]?.results?.[0]?.count ?? 0;

} catch (err) {
  console.error("Failed to load guest_wristbands:", err);
  todaysGuestCount = 0;
}


// ---------------------------------------------------------
// RENTAL COUNTS
// ---------------------------------------------------------
const rentedByType = {
  "Studio": 0,
  "1 Bedroom": 0,
  "2 Bedroom": 0,
  "3 Bedroom": 0
};

let yellowUsed = 0;
const yellowTotal = 274;

for (const row of (currentRentals?.results || [])) {
  const { unitNum, type } = parseUnit(row.unit);
  if (!type || !unitNum) continue;

  rentedByType[type]++;

  const dedicated = DEDICATED[unitNum] ?? 0;
  const allowed = ALLOWED[type] ?? 0;

  yellowUsed += Math.max(0, allowed - dedicated);
}

// ---------------------------------------------------------
// SAME-DAY CHECK-IN (CST)
// ---------------------------------------------------------
const arrivalsTodayRow = await DB.prepare(`
  SELECT COUNT(*) AS count
  FROM guests
  WHERE arrival = date('now','-5 hours')
`).first();

const sameDayRow = await DB.prepare(`
  SELECT COUNT(*) AS count
  FROM guests
  WHERE arrival = date('now','-5 hours') AND arrival = created
`).first();

const totalTodayCount = arrivalsTodayRow?.count ?? 0;
const sameDayCount = sameDayRow?.count ?? 0;
const sameDayPct = pct(sameDayCount, totalTodayCount);

// ---------------------------------------------------------
// DEPARTING TODAY (CST)
// ---------------------------------------------------------
const departingTodayRow = await DB.prepare(`
  SELECT COUNT(*) AS count
  FROM guests
  WHERE departure = date('now','-5 hours')
`).first();

const departingTodayCount = departingTodayRow?.count ?? 0;

// ---------------------------------------------------------
// ARRIVING TOMORROW (CST)
// ---------------------------------------------------------
const arrivingTomorrowRow = await DB.prepare(`
  SELECT COUNT(*) AS count
  FROM guests
  WHERE arrival = date('now','-5 hours','+1 day')
`).first();

const arrivingTomorrowCount = arrivingTomorrowRow?.count ?? 0;

// ---------------------------------------------------------
// TOTAL OCCUPANCY
// ---------------------------------------------------------
const studioPct = pct(rentedByType["Studio"], TOTAL["Studio"]);
const onePct = pct(rentedByType["1 Bedroom"], TOTAL["1 Bedroom"]);
const twoPct = pct(rentedByType["2 Bedroom"], TOTAL["2 Bedroom"]);
const threePct = pct(rentedByType["3 Bedroom"], TOTAL["3 Bedroom"]);
const yellowPct = pct(yellowUsed, yellowTotal);

const totalRented =
  rentedByType["Studio"] +
  rentedByType["1 Bedroom"] +
  rentedByType["2 Bedroom"] +
  rentedByType["3 Bedroom"];

const totalUnits =
  TOTAL["Studio"] +
  TOTAL["1 Bedroom"] +
  TOTAL["2 Bedroom"] +
  TOTAL["3 Bedroom"];

const totalPct = pct(totalRented, totalUnits);
---

<div style="margin-top: 1.5rem;">
  <p style="margin-bottom: 0.5rem; color:#9ca3af;">
    Status as of {new Date().toLocaleString("en-US", { timeZone: "America/Chicago" })}
  </p>

  <p style="margin-bottom: 1.5rem; color:#6b7280; font-size: 0.9rem;">
    Last pipeline sync:
    <strong>
      {lastSync
        ? new Date(lastSync.run_at).toLocaleString("en-US", {
            timeZone: "America/Chicago",
            hour12: true
          })
        : "No sync recorded"}
    </strong><br />
    Rows processed: {lastSync?.gathered ?? 0},
    pushed: {lastSync?.pushed ?? 0},
    failed: {lastSync?.failed ?? 0}
  </p>

  <div
    style="
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    "
  >
    <StatusCard label="Yellow Parking" value={`${yellowUsed}/${yellowTotal}`} percent={yellowPct} status={statusLabel(yellowPct)} note="Yellow spaces in use, Does not accout for BB or Staff" />
    <StatusCard label="Same-Day Check-ins" value={`${sameDayCount}/${totalTodayCount}`} percent={sameDayPct} status={statusLabel(sameDayPct)} note="Arrival date matches created date" />
    <StatusCard label="Departing Today" value={`${departingTodayCount}`} percent={0} status="Info" note="Guests leaving today" />
    <StatusCard label="Arriving Tomorrow" value={`${arrivingTomorrowCount}`} percent={0} status="Info" note="Forecast arrivals" />
    <StatusCard label="Studio" value={`${rentedByType["Studio"]}/${TOTAL["Studio"]}`} percent={studioPct} status={statusLabel(studioPct)} note="Rented / Available" />
    <StatusCard label="1 Bedroom" value={`${rentedByType["1 Bedroom"]}/${TOTAL["1 Bedroom"]}`} percent={onePct} status={statusLabel(onePct)} note="Rented / Available" />
    <StatusCard label="2 Bedroom" value={`${rentedByType["2 Bedroom"]}/${TOTAL["2 Bedroom"]}`} percent={twoPct} status={statusLabel(twoPct)} note="Rented / Available" />
    <StatusCard label="3 Bedroom" value={`${rentedByType["3 Bedroom"]}/${TOTAL["3 Bedroom"]}`} percent={threePct} status={statusLabel(threePct)} note="Rented / Available" />
    <StatusCard label="Total Occupancy" value={`${totalRented}/${totalUnits}/${todaysGuestCount}`} percent={totalPct} status={statusLabel(totalPct)} note="Rented / Available / Est Guests" />
  </div>
</div>
