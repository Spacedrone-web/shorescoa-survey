// Fetch current rentals
const currentRentals = await DB.prepare(
  `SELECT guest_name, email, unit, arrival, departure, createdAt
   FROM guests
   WHERE arrival <= date('now')
     AND departure >= date('now')`
).all();

// Same-day check-ins today
const sameDay = await DB.prepare(
  `SELECT guest_name, email, unit, arrival, createdAt
   FROM guests
   WHERE arrival = date('now')
     AND substr(createdAt, 1, 10) = date('now')`
).all();

// Helper: get unit number and stack/type
function parseUnit(raw: string | null): { unitNum: number | null; type: string | null } {
  if (!raw) return { unitNum: null, type: null };
  const base = raw.split(" ")[0];
  const unitNum = parseInt(base, 10);
  if (Number.isNaN(unitNum)) return { unitNum: null, type: null };
  const stack = base.slice(-2).padStart(2, "0");
  const type = STACK_MAP[stack] ?? null;
  return { unitNum, type };
}

// Count rentals by type
const rentedByType: Record<string, number> = {
  "Studio": 0,
  "1 Bedroom": 0,
  "2 Bedroom": 0,
  "3 Bedroom": 0
};

let yellowUsed = 0;
const yellowTotal = 274;

// For current rentals: count type + yellow used
for (const row of currentRentals.results ?? []) {
  const { unitNum, type } = parseUnit(row.unit as string | null);
  if (!type || !unitNum) continue;

  rentedByType[type]++;

  const dedicated = DEDICATED[unitNum] ?? 0;
  const allowed = ALLOWED[type];
  const yellow = Math.max(0, allowed - dedicated);
  yellowUsed += yellow;
}

// Same-day check-ins count
const sameDayCount = (sameDay.results ?? []).length;

// Same-day percentage
const today = new Date().toISOString().slice(0,10);
const totalToday = (currentRentals.results ?? []).filter(r => r.arrival === today).length;
const sameDayPct = totalToday ? (sameDayCount / totalToday) * 100 : 0;

// Bedroom percentages (fullness)
function pct(rented: number, total: number): number {
  return total ? (rented / total) * 100 : 0;
}

const studioPct = pct(rentedByType["Studio"], TOTAL["Studio"]);
const onePct = pct(rentedByType["1 Bedroom"], TOTAL["1 Bedroom"]);
const twoPct = pct(rentedByType["2 Bedroom"], TOTAL["2 Bedroom"]);
const threePct = pct(rentedByType["3 Bedroom"], TOTAL["3 Bedroom"]);
const yellowPct = pct(yellowUsed, yellowTotal);
---

<div style="margin-top: 1.5rem;">
  <p style="margin-bottom: 1rem; color:#9ca3af;">
    Status as of {new Date().toLocaleString("en-US", { timeZone: "America/Denver" })}
  </p>

  <div
    style="
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1.5rem;
    "
  >
    <Gauge
      label="Yellow Parking"
      value={`${yellowUsed}/${yellowTotal}`}
      max={yellowTotal}
      percent={yellowPct}
      subtitle="Yellow spaces in use"
    />

    <Gauge
      label