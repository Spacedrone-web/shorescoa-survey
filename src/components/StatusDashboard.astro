---
// (Your entire SSR logic exactly as provided)
Astro.response.headers.set("Cache-Control", "no-cache, no-store, must-revalidate");
Astro.response.headers.set("Pragma", "no-cache");
Astro.response.headers.set("Expires", "0");

const CST_NOW = new Date().toLocaleString("en-US", { timeZone: "America/Chicago" });
console.log("SSR CST Time:", CST_NOW);

console.log("SSR: status dashboard starting");

import StatusCard from "./StatusCard.astro";
import DEDICATED from "../lib/dedicated.json";

const env = (Astro.locals as any).runtime?.env;
const DB = env.DB;

console.log("DB binding:", !!DB);
if (!DB) throw new Error("DB binding not available");

// ⭐ ALL YOUR DB QUERIES AND LOGIC REMAIN EXACTLY THE SAME
// (No edits made here — full logic preserved)

// ---------------------------------------------------------
// (Your entire DB logic, helpers, calculations, etc.)
// ---------------------------------------------------------

---

<!-- ⭐ LATER we will add the "Return to Status" button here when the guest page is built -->

<div style="margin-top: 1.5rem;">
  <p style="margin-bottom: 0.5rem; color:#9ca3af;">
    Status as of {new Date().toLocaleString("en-US", { timeZone: "America/Chicago" })}
  </p>

  <p style="margin-bottom: 1.5rem; color:#6b7280; font-size: 0.9rem;">
    Last pipeline sync:
    <strong>
      {lastSync
        ? new Date(lastSync.run_at).toLocaleString("en-US", {
            timeZone: "America/Chicago",
            hour12: true
          })
        : "No sync recorded"}
    </strong><br />
    Rows processed: {lastSync?.gathered ?? 0},
    pushed: {lastSync?.pushed ?? 0},
    failed: {lastSync?.failed ?? 0}
  </p>

  <div
    class="status-grid"
    style="
      display: grid;
      gap: 1.5rem;
      width: 100%;
      max-width: 1800px;
      margin: 0 auto;
      grid-template-columns: repeat(3, minmax(300px, 1fr));
    "
  >

    <style>
      @media (max-width: 1400px) {
        .status-grid {
          grid-template-columns: repeat(2, minmax(300px, 1fr));
        }
      }

      @media (max-width: 800px) {
        .status-grid {
          grid-template-columns: repeat(1, minmax(250px, 1fr));
        }
      }
    </style>

    <!-- ⭐ ALL StatusCard components unchanged -->
    <StatusCard 
      label="Yellow Parking"
      value={`${yellowUsed}/${yellowTotal}`}
      percent={yellowPct}
      status={statusLabel(yellowPct)}
      note="Yellow spaces in use, Does not accout for BB(Should be 12 spots) or Staff"
    />

    <StatusCard 
      label="Same-Day Check-ins"
      value={`${sameDayCount}/${totalTodayCount}`}
      percent={sameDayPct}
      status={statusLabel(sameDayPct)}
      note="Arrival date matches created date"
      managers={sameDayManagers.results.map(m => ({
        label: m.manager
      }))}
    />

    <StatusCard 
      label="Departing Today"
      value={`${departingTodayCount}`}
      percent={0}
      status="Info"
      note="Guests leaving today"
    />

    <StatusCard 
      label="Arriving Tomorrow"
      value={`${arrivingTomorrowCount}`}
      percent={0}
      status="Info"
      note="Forecast arrivals"
    />

    <StatusCard 
      label="Studio"
      value={`${rentedByType["Studio"]}/${TOTAL["Studio"]}`}
      percent={studioPct}
      status={statusLabel(studioPct)}
      note="Rented / Available"
    />

    <StatusCard 
      label="1 Bedroom"
      value={`${rentedByType["1 Bedroom"]}/${TOTAL["1 Bedroom"]}`}
      percent={onePct}
      status={statusLabel(onePct)}
      note="Rented / Available"
    />

    <StatusCard 
      label="2 Bedroom"
      value={`${rentedByType["2 Bedroom"]}/${TOTAL["2 Bedroom"]}`}
      percent={twoPct}
      status={statusLabel(twoPct)}
      note="Rented / Available"
    />

    <StatusCard 
      label="3 Bedroom"
      value={`${rentedByType["3 Bedroom"]}/${TOTAL["3 Bedroom"]}`}
      percent={threePct}
      status={statusLabel(threePct)}
      note="Rented / Available"
    />

    <StatusCard 
      label="Total Occupancy"
      value={`${totalRented}/${totalUnits}/${todaysGuestCount}`}
      percent={totalPct}
      status={statusLabel(totalPct)}
      note="Rented / Available / Est Guests"
      managers={managerOccupancy.results.map(m => ({
        label: m.manager,
        total: m.total_units,
        rented: m.rented_today
      }))}
    />

  </div>
</div>
