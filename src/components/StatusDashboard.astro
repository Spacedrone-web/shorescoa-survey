---
import StatusCard from "./StatusCard.astro";
import DEDICATED from "../lib/dedicated.json";

const env = (Astro.locals as any).runtime?.env ?? {};
const DB = env.DB;

if (!DB) throw new Error("DB binding not available");

// Stack → type
const STACK_MAP = {
  "01": "3 Bedroom","02": "1 Bedroom","03": "2 Bedroom","04": "2 Bedroom",
  "05": "Studio","06": "Studio","07": "2 Bedroom","08": "1 Bedroom",
  "09": "1 Bedroom","10": "2 Bedroom","11": "1 Bedroom","12": "1 Bedroom",
  "13": "1 Bedroom","14": "1 Bedroom","15": "1 Bedroom","16": "1 Bedroom",
  "17": "1 Bedroom","18": "2 Bedroom","19": "2 Bedroom","20": "2 Bedroom",
  "21": "2 Bedroom","22": "2 Bedroom","23": "2 Bedroom","24": "2 Bedroom",
  "25": "1 Bedroom","26": "1 Bedroom","27": "1 Bedroom","28": "3 Bedroom",
  "29": "2 Bedroom","30": "1 Bedroom","31": "3 Bedroom"
};

const TOTAL = {
  "Studio": 41,
  "1 Bedroom": 292,
  "2 Bedroom": 231,
  "3 Bedroom": 61
};

const ALLOWED = {
  "Studio": 1,
  "1 Bedroom": 1,
  "2 Bedroom": 2,
  "3 Bedroom": 2
};

// Rentals (all active today)
const currentRentals = await DB.prepare(`
  SELECT unit, arrival, departure, createdAt
  FROM guests
  WHERE arrival <= date('now') AND departure >= date('now')
`).all();

// Helper: parse unit → number + type
function parseUnit(raw) {
  if (!raw) return { unitNum: null, type: null };
  const base = raw.split(" ")[0];
  const unitNum = parseInt(base, 10);
  if (Number.isNaN(unitNum)) return { unitNum: null, type: null };
  const stack = base.slice(-2).padStart(2, "0");
  return { unitNum, type: STACK_MAP[stack] ?? null };
}

// Count rentals by type + yellow usage
const rentedByType = {
  "Studio": 0,
  "1 Bedroom": 0,
  "2 Bedroom": 0,
  "3 Bedroom": 0
};

let yellowUsed = 0;
const yellowTotal = 274;

for (const row of currentRentals.results ?? []) {
  const { unitNum, type } = parseUnit(row.unit);
  if (!type || !unitNum) continue;

  rentedByType[type]++;

  const dedicated = DEDICATED[unitNum] ?? 0;
  const allowed = ALLOWED[type];
  yellowUsed += Math.max(0, allowed - dedicated);
}

// SAME-DAY CHECK-IN LOGIC (Symliv rule)
function iso(d) {
  return new Date(d).toISOString().slice(0,10);
}

const today = new Date().toISOString().slice(0,10);

// All passes arriving today
const arrivalsToday = (currentRentals.results ?? []).filter(r => iso(r.arrival) === today);

// Same-day check-ins = arrival date matches created date
const sameDay = arrivalsToday.filter(r => iso(r.arrival) === iso(r.createdAt));

// Counts
const sameDayCount = sameDay.length;
const totalTodayCount = arrivalsToday.length;

// Percentage
const sameDayPct = totalTodayCount
  ? (sameDayCount / totalTodayCount) * 100
  : 0;

// Percent helper
function pct(r, t) { return t ? (r / t) * 100 : 0; }

// Percentages
const studioPct = pct(rentedByType["Studio"], TOTAL["Studio"]);
const onePct = pct(rentedByType["1 Bedroom"], TOTAL["1 Bedroom"]);
const twoPct = pct(rentedByType["2 Bedroom"], TOTAL["2 Bedroom"]);
const threePct = pct(rentedByType["3 Bedroom"], TOTAL["3 Bedroom"]);
const yellowPct = pct(yellowUsed, yellowTotal);

// Status labels
function statusLabel(p) {
  if (p < 60) return "Low (Green)";
  if (p < 85) return "Moderate (Yellow)";
  return "High (Red)";
}
---

<div style="margin-top: 1.5rem;">
  <p style="margin-bottom: 1rem; color:#9ca3af;">
    Status as of {new Date().toLocaleString("en-US", { timeZone: "America/Denver" })}
  </p>

  <div
    style="
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    "
  >
    <!-- TOP ROW -->
    <StatusCard
      label="Yellow Parking"
      value={`${yellowUsed}/${yellowTotal}`}
      percent={yellowPct}
      status={statusLabel(yellowPct)}
      note="Yellow spaces in use"
    />

    <StatusCard
      label="Same-Day Check-ins"
      value={`${sameDayCount}/${totalTodayCount}`}
      percent={sameDayPct}
      status={statusLabel(sameDayPct)}
      note="Arrival date matches created date"
    />

    <StatusCard
      label="Studios"
      value={`${rentedByType["Studio"]}/${TOTAL["Studio"]}`}
      percent={studioPct}
      status={statusLabel(studioPct)}
      note="Rented / Available"
    />

    <!-- BOTTOM ROW -->
    <StatusCard
      label="1 Bedroom"
      value={`${rentedByType["1 Bedroom"]}/${TOTAL["1 Bedroom"]}`}
      percent={onePct}
      status={statusLabel(onePct)}
      note="Rented / Available"
    />

    <StatusCard
      label="2 Bedroom"
      value={`${rentedByType["2 Bedroom"]}/${TOTAL["2 Bedroom"]}`}
      percent={twoPct}
      status={statusLabel(twoPct)}
      note="Rented / Available"
    />

    <StatusCard
      label="3 Bedroom"
      value={`${rentedByType["3 Bedroom"]}/${TOTAL["3 Bedroom"]}`}
      percent={threePct}
      status={statusLabel(threePct)}
      note="Rented / Available"
    />
  </div>
</div>
