---
const { label, value, percent, status, note, managers } = Astro.props;
---

<style>
  /* ⭐ Mobile: stack columns vertically */
  @media (max-width: 800px) {
    .status-card {
      flex-direction: column !important;
      width: 100% !important;
    }

    .status-card-left,
    .status-card-right {
      flex: unset !important;
      width: 100% !important;
      border-left: none !important;
      padding-left: 0 !important;
    }

    .status-card-right {
      margin-top: 0.75rem;
    }
  }

  /* ⭐ iPad/tablet: reduce manager font sizes */
  @media (max-width: 1024px) {
    .status-card-right h4 {
      font-size: 0.8rem !important;
    }

    .status-card-right li {
      font-size: 0.75rem !important;
    }
  }
</style>

<div class="status-card" style="
  background: #2d2d2d;
  padding: 1rem 1.25rem;
  border-radius: 0.5rem;
  color: white;
  display: flex;
  justify-content: space-between;
  gap: 1.5rem;
">

  <!-- LEFT SIDE: Main Stats -->
  <div class="status-card-left" style="
    display: flex;
    flex-direction: column;
    gap: 0rem;
    flex: 4;
  ">
    <h3 style="font-size: 1.1rem; font-weight: 600; margin: 0;">
      {label}
    </h3>

    <p style="font-size: 1.4rem; font-weight: 700; margin: 0;">
      {value}
    </p>

    <p style="color: #9ca3af; margin: 0;">
      {percent.toFixed(1)}%
    </p>

    <p style="font-size: 0.9rem; color: #d1d5db; margin: 0;">
      {status}
    </p>

    <p style="font-size: 0.8rem; color: #9ca3af; margin: 0;">
      {note}
    </p>
  </div>

  <!-- RIGHT SIDE: Manager List -->
  {managers && managers.length > 0 && (
    <div class="status-card-right" style="
      flex: 1;
      border-left: 1px solid #374151;
      padding-left: 0.75rem;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      white-space: nowrap;
    ">
      <h4 style="font-size: 0.9rem; color:#d1d5db; margin-bottom: 0.25rem;">
        {label === "Same-Day Check-ins" && "Top Offenders"}
        {label === "Total Occupancy" && "(total/rented) Top Performers"}
        {label !== "Same-Day Check-ins" && label !== "Total Occupancy" && "Managers"}
      </h4>

      {managers.map(m => (
        <li style="list-style: none; padding-left: 0;">
          {label === "Total Occupancy"
            ? `(${m.total}/${m.rented}) ${m.label}`
            : m.label}
        </li>
      ))}
    </div>
  )}

</div>
