---
const { label, value, percent, status, note, managers } = Astro.props;
---

<div style="
  background: #1f2937;
  padding: 1rem 1.25rem;
  border-radius: 0.5rem;
  color: white;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  gap: 1.5rem;

  /* ⭐ Wider card like the old layout */
  min-width: 500px;
">

  <!-- LEFT SIDE: Main Stats -->
  <div style="
    display: flex;
    flex-direction: column;
    gap: 0.5rem;

  <!-- LEFT SIDE: Main Stats -->
  <div style="
    display: flex;
    flex-direction: column;

    /* ⭐ REMOVE GAPS COMPLETELY */
    gap: 0rem;

    /* ⭐ Keep left side wide */
    flex: 4;
  ">
    <h3 style="font-size: 1.1rem; font-weight: 600; margin: 0;">
      {label}
    </h3>

    <p style="font-size: 1.4rem; font-weight: 700; margin: 0;">
      {value}
    </p>

    <p style="color: #9ca3af; margin: 0;">
      {percent.toFixed(1)}%
    </p>

    <p style="font-size: 0.9rem; color: #d1d5db; margin: 0;">
      {status}
    </p>

    <p style="font-size: 0.8rem; color: #9ca3af; margin: 0;">
      {note}
    </p>
  </div>


  <!-- RIGHT SIDE: Manager List -->
  {managers && managers.length > 0 && (
    <div style="
      /* ⭐ Narrower manager column */
      flex: 1;

      /* ⭐ Move divider LEFT */
      border-left: 1px solid #374151;
      padding-left: 0.75rem;

      display: flex;
      flex-direction: column;
      gap: 0.25rem;

      /* ⭐ Prevent wrapping */
      white-space: nowrap;
    ">
      <h4 style="font-size: 0.9rem; color:#d1d5db; margin-bottom: 0.25rem;">
        Managers
      </h4>

      <ul style="
        font-size: 0.85rem;
        color:#9ca3af;
        line-height: 1.4;
        padding-left: 1rem;
        margin: 0;
      ">
        {managers.map(m => (
          <li>{m.label}</li>
        ))}
      </ul>
    </div>
  )}

</div>
