---
const { label, value, percent, status, note, managers } = Astro.props;
---

<div style="
  background: #1f2937;
  padding: 1rem 1.25rem;
  border-radius: 0.5rem;
  color: white;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
">
  <h3 style="font-size: 1.1rem; font-weight: 600;">
    {label}
  </h3>

  <p style="font-size: 1.4rem; font-weight: 700;">
    {value}
  </p>

  <p style="color: #9ca3af;">
    {percent.toFixed(1)}%
  </p>

  <p style="font-size: 0.9rem; color: #d1d5db;">
    {status}
  </p>

  <p style="font-size: 0.8rem; color: #9ca3af;">
    {note}
  </p>

  {managers && managers.length > 0 && (
    <div style="margin-top: 0.75rem; border-top: 1px solid #374151; padding-top: 0.75rem;">
      <h4 style="font-size: 0.9rem; color:#d1d5db; margin-bottom: 0.5rem;">
        Managers
      </h4>

      <ul style="font-size: 0.85rem; color:#9ca3af; line-height: 1.4; padding-left: 1rem;">
        {managers.map(m => (
          <li>{m.label}</li>
        ))}
      </ul>
    </div>
  )}

</div>

