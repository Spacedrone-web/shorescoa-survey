---
const { label, value, percent, status, note, managers } = Astro.props;
---

<div style="
  background: #1f2937;
  padding: 1rem 1.25rem;
  border-radius: 0.5rem;
  color: white;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  gap: 1.5rem;

  /* ⭐ match old width */
  min-width: 450px;
">

  <!-- LEFT SIDE -->
  <div style="display: flex; flex-direction: column; gap: 0.5rem; flex: 2;">
    <h3 style="font-size: 1.1rem; font-weight: 600;">
      {label}
    </h3>

    <p style="font-size: 1.4rem; font-weight: 700;">
      {value}
    </p>

    <p style="color: #9ca3af;">
      {percent.toFixed(1)}%
    </p>

    <p style="font-size: 0.9rem; color: #d1d5db;">
      {status}
    </p>

    <p style="font-size: 0.8rem; color: #9ca3af;">
      {note}
    </p>
  </div>

  <!-- RIGHT SIDE -->
  {managers && managers.length > 0 && (
    <div style="
      flex: 1;
      border-left: 1px solid #374151;
      padding-left: 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    ">
      <h4 style="font-size: 0.9rem; color:#d1d5db; margin-bottom: 0.25rem;">
        Managers
      </h4>

      <ul style="font-size: 0.85rem; color:#9ca3af; line-height: 1.4; padding-left: 1rem; margin: 0;">
        {managers.map(m => (
          <li>{m.label}</li>
        ))}
      </ul>
    </div>
  )}

</div>
