---
const {
  label,
  value,
  percent,
  subtitle
} = Astro.props;

// Clamp percent
const pct = Math.max(0, Math.min(100, percent ?? 0));

// Needle math (semi-circle: -90° to +90°)
const angle = -90 + (pct / 100) * 180;
const radius = 80;
const cx = 100;
const cy = 110;
const rad = (angle * Math.PI) / 180;
const needleX = cx + radius * Math.cos(rad);
const needleY = cy + radius * Math.sin(rad);

// Correct arc length for radius 80
const FULL_ARC = Math.PI * 80; // ≈ 251.3

// Segmentation (60% green, 25% yellow, 15% red)
const GREEN_LEN = FULL_ARC * 0.60;
const YELLOW_LEN = FULL_ARC * 0.25;
const RED_LEN = FULL_ARC * 0.15;
---

<!-- Label ABOVE gauge -->
<div style="text-align:center; margin-bottom: 0.25rem;">
  <div style="color:#e5e7eb; font-size:14px; font-weight:600;">
    {label}
  </div>
</div>

<svg viewBox="0 0 200 140" style="width: 100%; max-width: 260px;">

  <!-- GREEN zone -->
  <path
    d="M20 110 A80 80 0 0 1 180 110"
    fill="none"
    stroke="#22c55e"
    stroke-width="16"
    stroke-linecap="round"
    stroke-dasharray={`${GREEN_LEN} 1000`}
  />

  <!-- YELLOW zone -->
  <path
    d="M20 110 A80 80 0 0 1 180 110"
    fill="none"
    stroke="#eab308"
    stroke-width="16"
    stroke-linecap="round"
    stroke-dasharray={`${YELLOW_LEN} 1000`}
    stroke-dashoffset={`-${GREEN_LEN}`}
  />

  <!-- RED zone -->
  <path
    d="M20 110 A80 80 0 0 1 180 110"
    fill="none"
    stroke="#ef4444"
    stroke-width="16"
    stroke-linecap="round"
    stroke-dasharray={`${RED_LEN} 1000`}
    stroke-dashoffset={`-${GREEN_LEN + YELLOW_LEN}`}
  />

  <!-- Percent markers -->
  <text x="40" y="95" text-anchor="middle" fill="#9ca3af" font-size="10">60%</text>
  <text x="160" y="95" text-anchor="middle" fill="#9ca3af" font-size="10">85%</text>

  <!-- Needle -->
  <line
    x1={cx}
    y1={cy}
    x2={needleX}
    y2={needleY}
    stroke="#f9fafb"
    stroke-width="3"
    stroke-linecap="round"
  />
  <circle cx={cx} cy={cy} r="4" fill="#f9fafb" />

  <!-- Center value -->
  <text
    x="100"
    y="105"
    text-anchor="middle"
    fill="#e5e7eb"
    font-size="16"
    font-weight="600"
  >
    {value}
  </text>

  <!-- Subtitle -->
  {subtitle && (
    <text
      x="100"
      y="122"
      text-anchor="middle"
      fill="#9ca3af"
      font-size="12"
    >
      {subtitle}
    </text>
  )}
</svg>
