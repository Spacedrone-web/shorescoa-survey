---
const {
  label,
  value,
  max,
  percent,
  color,
  subtitle
} = Astro.props;

// Clamp percent
const pct = Math.max(0, Math.min(100, percent ?? 0));

// Map percent to angle (semi-circle: -90° to +90°)
const angle = -90 + (pct / 100) * 180;
const radius = 80;
const cx = 100;
const cy = 110;
const rad = (angle * Math.PI) / 180;
const needleX = cx + radius * Math.cos(rad);
const needleY = cy + radius * Math.sin(rad);

let strokeColor = "#22c55e";
if (pct > 90) strokeColor = "#ef4444";
else if (pct > 75) strokeColor = "#eab308";
---

<svg viewBox="0 0 200 140" style="width: 100%; max-width: 260px;">
  <!-- Background arc (grey) -->
  <path
    d="M20 110 A80 80 0 0 1 180 110"
    fill="none"
    stroke="#1f2937"
    stroke-width="16"
    stroke-linecap="round"
  />

  <!-- Colored arc -->
  <path
    d="M20 110 A80 80 0 0 1 180 110"
    fill="none"
    stroke={strokeColor}
    stroke-width="16"
    stroke-linecap="round"
    stroke-dasharray={`${pct * 2.51} 1000`}
  />

  <!-- Needle -->
  <line
    x1={cx}
    y1={cy}
    x2={needleX}
    y2={needleY}
    stroke="#f9fafb"
    stroke-width="3"
    stroke-linecap="round"
  />
  <circle cx={cx} cy={cy} r="4" fill="#f9fafb" />

  <!-- Label -->
  <text
    x="100"
    y="30"
    text-anchor="middle"
    fill="#e5e7eb"
    font-size="14"
    font-weight="600"
  >
    {label}
  </text>

  <!-- Center value -->
  <text
    x="100"
    y="105"
    text-anchor="middle"
    fill="#e5e7eb"
    font-size="16"
    font-weight="600"
  >
    {value}
  </text>

  <!-- Subtitle -->
  {subtitle && (
    <text
      x="100"
      y="122"
      text-anchor="middle"
      fill="#9ca3af"
      font-size="12"
    >
      {subtitle}
    </text>
  )}
</svg>
