---
const { label, value, percent, subtitle } = Astro.props;

// Clamp percent
const pct = Math.max(0, Math.min(100, percent ?? 0));

// Needle angle (-90° to +90°)
const angle = -90 + (pct / 100) * 180;
const rad = (angle * Math.PI) / 180;

// Needle geometry
const cx = 100;
const cy = 110;
const radius = 80;
const needleX = cx + radius * Math.cos(rad);
const needleY = cy + radius * Math.sin(rad);
---

<div style="text-align:center;">

  <!-- Label ABOVE gauge -->
  <div style="margin-bottom: 0.25rem; color:#e5e7eb; font-size:15px; font-weight:600;">
    {label}
  </div>

  <svg viewBox="0 0 200 140" style="width: 100%; max-width: 260px;">

    <!-- GREEN zone (0–60%) -->
    <path
      d="M20 110 A80 80 0 0 1 180 110"
      fill="none"
      stroke="#22c55e"
      stroke-width="16"
      stroke-linecap="round"
    />

    <!-- YELLOW zone (overlay 60–85%) -->
    <path
      d="M20 110 A80 80 0 0 1 180 110"
      fill="none"
      stroke="#eab308"
      stroke-width="16"
      stroke-linecap="round"
      stroke-dasharray="25 200"
      stroke-dashoffset="-60"
    />

    <!-- RED zone (overlay 85–100%) -->
    <path
      d="M20 110 A80 80 0 0 1 180 110"
      fill="none"
      stroke="#ef4444"
      stroke-width="16"
      stroke-linecap="round"
      stroke-dasharray="15 200"
      stroke-dashoffset="-85"
    />

    <!-- Needle -->
    <line
      x1={cx}
      y1={cy}
      x2={needleX}
      y2={needleY}
      stroke="#f9fafb"
      stroke-width="3"
      stroke-linecap="round"
    />
    <circle cx={cx} cy={cy} r="4" fill="#f9fafb" />

    <!-- Center value -->
    <text
      x="100"
      y="105"
      text-anchor="middle"
      fill="#e5e7eb"
      font-size="17"
      font-weight="600"
    >
      {value}
    </text>

    <!-- Subtitle -->
    {subtitle && (
      <text
        x="100"
        y="122"
        text-anchor="middle"
        fill="#9ca3af"
        font-size="12"
      >
        {subtitle}
      </text>
    )}
  </svg>
</div>