---
const {
  label,
  value,
  max,
  percent,
  subtitle
} = Astro.props;

// Clamp percent
const pct = Math.max(0, Math.min(100, percent ?? 0));

// Needle math (semi-circle: -90° to +90°)
const angle = -90 + (pct / 100) * 180;
const radius = 80;
const cx = 100;
const cy = 110;
const rad = (angle * Math.PI) / 180;
const needleX = cx + radius * Math.cos(rad);
const needleY = cy + radius * Math.sin(rad);

// Arc lengths for segmentation
// Full semi-circle ≈ 188 units (we use 188 for 75%, 47 for 15%, 47 for 15%)
const GREEN_LEN = 188;  // 0–75%
const YELLOW_LEN = 47;  // 76–90%
const RED_LEN = 47;     // 91–100%
---

<svg viewBox="0 0 200 140" style="width: 100%; max-width: 260px;">

  <!-- GREEN zone (0–75%) -->
  <path
    d="M20 110 A80 80 0 0 1 180 110"
    fill="none"
    stroke="#22c55e"
    stroke-width="16"
    stroke-linecap="round"
    stroke-dasharray={`${GREEN_LEN} 1000`}
  />

  <!-- YELLOW zone (76–90%) -->
  <path
    d="M20 110 A80 80 0 0 1 180 110"
    fill="none"
    stroke="#eab308"
    stroke-width="16"
    stroke-linecap="round"
    stroke-dasharray={`${YELLOW_LEN} 1000`}
    stroke-dashoffset={`-${GREEN_LEN}`}
  />

  <!-- RED zone (91–100%) -->
  <path
    d="M20 110 A80 80 0 0 1 180 110"
    fill="none"
    stroke="#ef4444"
    stroke-width="16"
    stroke-linecap="round"
    stroke-dasharray={`${RED_LEN} 1000`}
    stroke-dashoffset={`-${GREEN_LEN + YELLOW_LEN}`}
  />

  <!-- Needle -->
  <line
    x1={cx}
    y1={cy}
    x2={needleX}
    y2={needleY}
    stroke="#f9fafb"
    stroke-width="3"
    stroke-linecap="round"
  />
  <circle cx={cx} cy={cy} r="4" fill="#f9fafb" />

  <!-- Label -->
  <text
    x="100"
    y="30"
    text-anchor="middle"
    fill="#e5e7eb"
    font-size="14"
    font-weight="600"
  >
    {label}
  </text>

  <!-- Center value -->
  <text
    x="100"
    y="105"
    text-anchor="middle"
    fill="#e5e7eb"
    font-size="16"
    font-weight="600"
  >
    {value}
  </text>

  <!-- Subtitle -->
  {subtitle && (
    <text
      x="100"
      y="122"
      text-anchor="middle"
      fill="#9ca3af"
      font-size="12"
    >
      {subtitle}
    </text>
  )}
</svg>
