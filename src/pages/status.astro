---
import StatusDashboard from "../components/StatusDashboard.astro";

const PASSWORD = "Shores9900!";
let ok = false;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  ok = form.get("pw") === PASSWORD;
}
---

<html>
  <body>
    {!ok && (password form)}
    {ok && <StatusDashboard />}
  </body>
</html>
