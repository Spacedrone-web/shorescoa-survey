---
import StatusDashboard from "../components/StatusDashboard.astro";

const PASSWORD = "Shores9900!";

// ⭐ Check cookie first
const authCookie = Astro.cookies.get("sop_auth");
let ok = authCookie?.value === "ok";

// ⭐ If cookie not set, check POST password
if (!ok && Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const pw = form.get("pw");

  if (pw === PASSWORD) {
    ok = true;

    // ⭐ Set cookie so future visits skip password
    Astro.cookies.set("sop_auth", "ok", {
      path: "/",
      httpOnly: true,
      sameSite: "strict",
      maxAge: 60 * 60 * 12 // 12 hours
    });
  }
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>ShoresCOA Status</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon-circle-v3.ico">

    <style>
      body {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: #0f172a;
        color: #e5e7eb;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        min-height: 100vh;
        padding: 0;
        margin: 0;
      }

      .card {
        background: #111827;
        border-radius: 0.75rem;
        padding: 2rem;
        width: 100%;
        max-width: 1800px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.5);
      }

      .top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
      }

      .nav-btn {
        background: #ffffff;
        color: #000000;
        border: 2px solid #000000;
        padding: 10px 18px;
        border-radius: 6px;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
        transition: 0.2s;
      }

      .nav-btn:hover {
        background: #e5e5e5;
      }

      h1 {
        margin: 0;
        font-size: 1.75rem;
      }

      form {
        display: flex;
        gap: 0.75rem;
        margin-top: 1rem;
      }

      input[type="password"] {
        flex: 1;
        padding: 0.5rem 0.75rem;
        border-radius: 0.375rem;
        border: 1px solid #374151;
        background: #020617;
        color: #e5e7eb;
      }

      button {
        padding: 0.5rem 1rem;
        border-radius: 0.375rem;
        border: none;
        background: #22c55e;
        color: #022c22;
        font-weight: 600;
        cursor: pointer;
      }

      button:hover {
        background: #16a34a;
      }
    </style>
  </head>

  <body>
    <div class="card">

      <!-- ⭐ TOP BAR -->
      <div class="top-bar">
        <h1>ShoresCOA Status</h1>

        { ok && (
          <button class="nav-btn" onclick="window.location.href='/guest'">
            Guest Registration
          </button>
        )}
      </div>

      <!-- ⭐ PASSWORD SCREEN -->
      { !ok && (
        <>
          <p>Enter status password to view gauges.</p>
          <form method="POST">
            <input type="password" name="pw" placeholder="Password" autocomplete="off" />
            <button type="submit">Enter</button>
          </form>
        </>
      )}

      <!-- ⭐ DASHBOARD -->
      { ok && <StatusDashboard /> }
    </div>
  </body>
</html>
