    <span class="badge-pill unsent-pill" id="navUnsent">— Unsent</span>
    <a href="/admin" class="nav-btn">&#8592; Survey Admin</a>
    <a href="/admin?logout=1" class="nav-btn">Logout</a>
  </div>
</nav>

<main>
  <div class="controls">
    <button id="loadBtn" class="btn btn-primary">&#128100; Load Guests</button>

    <div class="sync-wrap">
      <button id="syncBtn" class="btn btn-warning">&#8635; Sync Symliv</button>
      <span class="last-sync" id="lastSyncLabel"></span>
    </div>

    <button id="testBtn" class="btn btn-info">&#9993; Send Test Email</button>

    <button id="bccMailtoBtn" class="btn btn-bcc" disabled>&#128231; Open BCC Mailto</button>
    <button id="markSentBtn"  class="btn btn-success" disabled>&#10003; Mark Selected as Sent</button>
    <button id="exportCsvBtn" class="btn btn-secondary">&#128190; Download CSV</button>

    <select id="filterSel">
      <option value="unsent" selected>Not Sent</option>
      <option value="all">All Guests</option>
      <option value="sent">Sent</option>
    </select>
  </div>

  <div class="status-bar"  id="statusBar">Click <strong>Load Guests</strong> to begin, or <strong>Sync Symliv</strong> to pull new registrations.</div>
  <div class="filter-note" id="filterNote"></div>

  <div class="bulk-bar" id="bulkBar">
    <input type="checkbox" id="selectAll" title="Select all visible" />
    <label for="selectAll" style="font-size:.83rem;cursor:pointer">Select All</label>
    <span id="selectedCount" style="flex:1;font-size:.83rem">0 selected</span>
  </div>

  <div class="table-wrap">
    <div id="noData">No guests to display.</div>
    <table id="guestTable" style="display:none">
      <thead>
        <tr>
          <th><input type="checkbox" id="selectAllHead" /></th>
          <th>Guest Name</th><th>Email</th><th>Unit / Address</th>
          <th>Arrival</th><th>Departure</th><th>Email Sent</th><th>Action</th>
        </tr>
      </thead>
      <tbody id="guestBody"></tbody>
    </table>
  </div>
</main>

<!-- Test Email Modal -->
<div class="modal-overlay" id="testModal">
  <div class="modal-box">
    <h3>&#9993; Send Test Survey Email</h3>
    <p style="font-size:.85rem;color:#475569;margin-bottom:.75rem">Sends a [TEST] copy via <strong>survey@shorescoa.com</strong> for verification.</p>
    <input type="email" id="testEmailInput" placeholder="recipient@example.com" />
    <div id="testResult" style="font-size:.84rem;min-height:1.2rem"></div>
    <div class="modal-footer">
      <button class="btn btn-secondary" id="cancelTest">Cancel</button>
      <button class="btn btn-info"      id="sendTestBtn">Send Test</button>
    </div>
  </div>
</div>

<script>
(function(){
  'use strict';
  const $ = id => document.getElementById(id);

  const loadBtn       = $('loadBtn');
  const syncBtn       = $('syncBtn');
  const lastSyncLabel = $('lastSyncLabel');
  const testBtn       = $('testBtn');
  const bccMailtoBtn  = $('bccMailtoBtn');
  const markSentBtn   = $('markSentBtn');
  const exportCsvBtn  = $('exportCsvBtn');
  const filterSel     = $('filterSel');
  const statusBar     = $('statusBar');
  const filterNote    = $('filterNote');
  const bulkBar       = $('bulkBar');
  const selectAll     = $('selectAll');
  const selectAllHead = $('selectAllHead');
  const selectedCount = $('selectedCount');
  const guestTable    = $('guestTable');
  const guestBody     = $('guestBody');
  const noData        = $('noData');
  const navSent       = $('navSent');
  const navUnsent     = $('navUnsent');
  const testModal     = $('testModal');
  const testEmailInput= $('testEmailInput');
  const cancelTest    = $('cancelTest');
  const sendTestBtn   = $('sendTestBtn');
  const testResult    = $('testResult');

  let allGuests = [], visibleRows = [];

  /* ── helpers ── */
  function cutoff() {
    const d = new Date();
    d.setDate(d.getDate() - 2);
    return d.toISOString().slice(0, 10);
  }

  function esc(s) {
    return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  function sentBadge(v) {
    return v === 'yes'
      ? '<span class="badge-sent">&#10003; Sent</span>'
      : '<span class="badge-unsent">&#10007; Not Sent</span>';
  }

  function updateNavBadges() {
    navSent.textContent   = allGuests.filter(g => g.email_sent === 'yes').length + ' Sent';
    navUnsent.textContent = allGuests.filter(g => g.email_sent !== 'yes').length + ' Unsent';
  }

  /* ── format ISO timestamp nicely ── */
  function fmtSync(iso) {
    if (!iso) return '';
    try {
      const d = new Date(iso);
      return 'Last sync’d: ' + d.toLocaleDateString() + ' ' +
        d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    } catch { return ''; }
  }
  /* --- FULL FILE BLOCK 1 END --- */
  
  /* --- FULL FILE BLOCK 2 START --- */
  /* ── filter + render ── */
  function applyFilters() {
    const cut  = cutoff();
    const mode = filterSel.value;
    const eligible = allGuests.filter(g => g.departure && g.departure <= cut);
    const hiddenN  = allGuests.length - eligible.length;
    filterNote.style.display = hiddenN > 0 ? 'block' : 'none';
    if (hiddenN > 0)
      filterNote.textContent = '⚠ ' + hiddenN + ' guest' + (hiddenN > 1 ? 's' : '') +
        ' hidden — departed within the last 2 days. They appear automatically once eligible.';
    visibleRows = mode === 'sent'   ? eligible.filter(g => g.email_sent === 'yes')
                : mode === 'unsent' ? eligible.filter(g => g.email_sent !== 'yes')
                : eligible;
    renderTable(visibleRows);
    updateNavBadges();
  }

  filterSel.addEventListener('change', () => { if (allGuests.length) applyFilters(); });

  /* ── API helper ── */
  async function apiJson(url, opts) {
    const r = await fetch(url, opts);
    const t = await r.text();
    try { return JSON.parse(t); } catch { throw new Error('API error ' + r.status); }
  }

  /* ── Load Guests ── */
  loadBtn.addEventListener('click', async () => {
    statusBar.innerHTML = '<span class="spinner"></span>&nbsp; Loading…';
    loadBtn.disabled = true;
    guestTable.style.display = 'none';
    noData.style.display = 'none';
    bulkBar.style.display = 'none';
    try {
      const d = await apiJson('/api/guests');
      if (!d.ok) throw new Error(d.error || 'Load failed');
      allGuests = d.guests || [];

      /* FIXED: lastSynced */
      if (d.lastSynced && lastSyncLabel) {
        lastSyncLabel.textContent = fmtSync(d.lastSynced);
      }

      applyFilters();
      statusBar.innerHTML = 'Loaded <strong>' + allGuests.length + '</strong> total guests.';
    } catch(e) {
      statusBar.innerHTML = '<span class="err">Error: ' + esc(e.message) + '</span>';
    } finally {
      loadBtn.disabled = false;
    }
  });

  /* ── Sync Symliv ── */
  syncBtn.addEventListener('click', async () => {
    statusBar.innerHTML = '<span class="spinner"></span>&nbsp; Syncing from Symliv…';
    syncBtn.disabled = true;
    try {
      const d = await apiJson('/api/sync-guests', { method: 'POST' });
      if (!d.ok) throw new Error(d.error || 'Sync failed');

      statusBar.innerHTML = '✔ Sync complete — ' + (d.inserted ?? 0) +
        ' new guest' + (d.inserted !== 1 ? 's' : '') + ' added.';

      /* FIXED: lastSynced */
      if (d.lastSynced && lastSyncLabel) {
        lastSyncLabel.textContent = fmtSync(d.lastSynced);
      }

      const r2 = await apiJson('/api/guests');
      allGuests = r2.guests || [];
      applyFilters();
    } catch(e) {
      statusBar.innerHTML = '<span class="err">Sync error: ' + esc(e.message) + '</span>';
    } finally {
      syncBtn.disabled = false;
    }
  });

  /* ── Render table ── */
  function renderTable(rows) {
    guestBody.innerHTML = '';
    if (!rows.length) {
      noData.style.display = 'block';
      guestTable.style.display = 'none';
      bulkBar.style.display = 'none';
      bccMailtoBtn.disabled = true;
      markSentBtn.disabled  = true;
      return;
    }
    noData.style.display = 'none';
    guestTable.style.display = '';
    bulkBar.style.display = 'flex';

    rows.forEach((g, i) => {
      const has  = !!g.email;
      const sent = g.email_sent === 'yes';
      const tr   = document.createElement('tr');
      tr.dataset.idx = i;
      tr.innerHTML =
        '<td><input type="checkbox" class="row-check" data-idx="' + i + '"' + (has ? '' : ' disabled') + '/></td>' +
        '<td>' + esc(g.guest_name) + '</td>' +
        '<td>' + (has ? esc(g.email) : '<span class="no-email">no email</span>') + '</td>' +
        '<td>' + esc(g.unit) + '</td>' +
        '<td>' + esc(g.arrival) + '</td>' +
        '<td>' + esc(g.departure) + '</td>' +
        '<td id="sc-' + g.id + '">' + sentBadge(g.email_sent) + '</td>' +
        '<td>' + (has ? '<button class="send-btn" data-id="' + g.id + '" data-idx="' + i + '">' + (sent ? 'Resend' : 'Send') + '</button>' : '&mdash;') + '</td>';
      guestBody.appendChild(tr);
    });

    document.querySelectorAll('.row-check').forEach(c => c.addEventListener('change', updateSel));
    document.querySelectorAll('.send-btn').forEach(b => b.addEventListener('click', onSend));
    selectAll.checked = false;
    selectAllHead.checked = false;
    updateSel();
  }

  /* ── updateSel — enables/disables BCC + Mark Sent ── */
  function updateSel() {
    const n = document.querySelectorAll('.row-check:checked').length;
    selectedCount.textContent = n + ' selected';
    bccMailtoBtn.disabled = (n === 0);
    markSentBtn.disabled  = (n === 0);
  }

  function syncChecks(v) {
    document.querySelectorAll('.row-check:not([disabled])').forEach(c => { c.checked = v; });
    updateSel();
  }
  selectAll.addEventListener('change', () => syncChecks(selectAll.checked));
  selectAllHead.addEventListener('change', () => {
    selectAll.checked = selectAllHead.checked;
    syncChecks(selectAllHead.checked);
  });

  /* ── Open BCC Mailto ── */
  bccMailtoBtn.addEventListener('click', () => {
    const checked = document.querySelectorAll('.row-check:checked');
    const emails  = [];
    checked.forEach(c => {
      const idx = parseInt(c.dataset.idx);
      const g   = visibleRows[idx];
      if (g && g.email) emails.push(g.email);
    });
    if (!emails.length) return;
    const bcc     = emails.join(',');
    const subject = encodeURIComponent('Your Experience at Shores of Panama');
    const body    = encodeURIComponent(
      'Dear Guest,\r\n\r\n' +
      'Thank you for staying at Shores of Panama!\r\n' +
      'We hope you had a wonderful visit.\r\n\r\n' +
      'We would love to hear about your experience.\r\n' +
      'Please take a moment to complete our brief guest survey:\r\n' +
      'https://survey.shorescoa.com/go\r\n\r\n' +
      'Your feedback helps us continue to improve the property and services for all guests.\r\n\r\n' +
      'Thank you,\r\n' +
      'Shores of Panama COA'
    );
    window.location.href = 'mailto:?bcc=' + encodeURIComponent(bcc) +
      '&subject=' + subject + '&body=' + body;
  });
/* --- FULL FILE BLOCK 2 END --- */

/* --- FULL FILE BLOCK 3 START --- */
  /* ── Mark Selected as Sent ── */
  markSentBtn.addEventListener('click', async () => {
    const checked = document.querySelectorAll('.row-check:checked');
    if (!checked.length) return;
    markSentBtn.disabled = true;
    markSentBtn.textContent = 'Marking…';
    let done = 0, failed = 0;

    for (const c of checked) {
      const idx = parseInt(c.dataset.idx);
      const g   = visibleRows[idx];
      if (!g) continue;

      try {
        await apiJson('/api/guests', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: g.id, emailSent: 'yes' })
        });

        g.email_sent = 'yes';
        const cell = $('sc-' + g.id);
        if (cell) cell.innerHTML = sentBadge('yes');
        done++;

      } catch {
        failed++;
      }
    }

    updateNavBadges();
    markSentBtn.innerHTML = '✓ Mark Selected as Sent';
    markSentBtn.disabled = false;

    statusBar.innerHTML =
      '✓ Marked <strong>' + done + '</strong> guest' +
      (done !== 1 ? 's' : '') + ' as sent' +
      (failed ? ' <span class="err">(' + failed + ' failed)</span>' : '') + '.';

    syncChecks(false);
    selectAll.checked = false;
    selectAllHead.checked = false;
  });

  /* ── Individual Send ── */
  async function onSend(e) {
    const btn = e.currentTarget;
    const id  = parseInt(btn.dataset.id);
    const idx = parseInt(btn.dataset.idx);
    const g   = visibleRows[idx];

    if (!g?.email) return;

    btn.disabled = true;
    btn.textContent = 'Sending…';

    try {
      const d = await apiJson('/api/send-email', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ to: g.email, name: g.guest_name })
      });

      if (!d.ok) throw new Error(d.error || 'Send failed');

      await apiJson('/api/guests', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, emailSent: 'yes' })
      });

      g.email_sent = 'yes';
      const cell = $('sc-' + id);
      if (cell) cell.innerHTML = sentBadge('yes');

      btn.textContent = '✓ Sent';
      btn.disabled = false;
      updateNavBadges();

    } catch(err) {
      btn.textContent = 'Retry';
      btn.disabled = false;
      statusBar.innerHTML =
        '<span class="err">Send failed for ' + esc(g.email) + ': ' +
        esc(err.message) + '</span>';
    }
  }

  /* ── Download CSV ── */
  exportCsvBtn.addEventListener('click', () => {
    if (!visibleRows.length) return;

    const hdr   = ['id','guest_name','email','unit','arrival','departure','email_sent'];
    const lines = [
      hdr.join(','),
      ...visibleRows.map(g =>
        hdr.map(h => '"' + String(g[h] ?? '').replace(/"/g, '""') + '"').join(',')
      )
    ];

    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([lines.join('\r\n')], { type: 'text/csv' }));
    a.download = 'shores-guests-' + new Date().toISOString().slice(0, 10) + '.csv';
    a.click();
  });

  /* ── Test Email Modal ── */
  testBtn.addEventListener('click', () => {
    testEmailInput.value = '';
    testResult.textContent = '';
    testModal.classList.add('open');
    testEmailInput.focus();
  });

  cancelTest.addEventListener('click', () => testModal.classList.remove('open'));

  testModal.addEventListener('click', e => {
    if (e.target === testModal) testModal.classList.remove('open');
  });

  sendTestBtn.addEventListener('click', async () => {
    const addr = testEmailInput.value.trim();
    if (!addr) {
      testResult.innerHTML = '<span class="err">Please enter an email address.</span>';
      return;
    }

    sendTestBtn.disabled = true;
    testResult.innerHTML = '<span class="spinner"></span>&nbsp; Sending…';

    try {
      const d = await apiJson('/api/send-email', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ to: addr, name: 'Test Guest', test: true })
      });

      if (!d.ok) throw new Error(d.error || 'Failed');

      testResult.innerHTML =
        '<span style="color:#16a34a">✓ Test sent to <strong>' +
        esc(addr) + '</strong></span>';

    } catch(err) {
      testResult.innerHTML =
        '<span class="err">✗ ' + esc(err.message) + '</span>';

    } finally {
      sendTestBtn.disabled = false;
    }
  });

  /* ── Auto-refresh lastSynced (FIXED) ── */
  async function refreshLastSynced() {
    try {
      const m = await apiJson('/api/meta');

      if (m?.lastSynced && lastSyncLabel) {
        lastSyncLabel.textContent = fmtSync(m.lastSynced);
      }

    } catch (err) {
      console.error('Failed to refresh lastSynced', err);
    }
  }

  setInterval(refreshLastSynced, 60000);

  /* ── Auto-load on page open ── */
  loadBtn.click();

})();
</script>
</body>
</html>
