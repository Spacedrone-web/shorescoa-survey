---
export const prerender = false;

const AUTH_COOKIE = 'admin_auth';
const AUTH_TOKEN  = 'shores-admin-ok';

const authed = Astro.cookies.get(AUTH_COOKIE)?.value === AUTH_TOKEN;
if (!authed) {
  return Astro.redirect('/admin');
}
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Guest Email Tool – Shores of Panama</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:#f0f4f8;min-height:100vh}
    .header{background:#0a2744;color:#fff;padding:.9rem 1.5rem;display:flex;align-items:center;justify-content:space-between}
    .header h1{font-size:1.25rem;font-weight:800;letter-spacing:1px}
    .header-right{display:flex;align-items:center;gap:.75rem}
    .btn-sm{padding:.35rem .9rem;border-radius:6px;font-size:.82rem;font-weight:700;cursor:pointer;border:none;letter-spacing:.4px;transition:background .2s;text-decoration:none;display:inline-block}
    .btn-secondary{background:rgba(255,255,255,.15);color:#fff}
    .btn-secondary:hover{background:rgba(255,255,255,.28)}
    .controls{background:#fff;border-bottom:1px solid #e2e8f0;padding:1rem 1.5rem;display:flex;flex-wrap:wrap;gap:.9rem;align-items:flex-end}
    .ctrl-group{display:flex;flex-direction:column;gap:.25rem}
    .ctrl-group label{font-size:.75rem;font-weight:700;color:#4a5568;text-transform:uppercase;letter-spacing:.5px}
    .ctrl-group input[type=date]{padding:.45rem .7rem;border:1.5px solid #cbd5e0;border-radius:7px;font-size:.9rem;color:#2d3748;outline:none;transition:border .2s}
    .ctrl-group input[type=date]:focus{border-color:#0a2744}
    .btn-primary{padding:.5rem 1.4rem;background:#0a2744;color:#fff;border:none;border-radius:7px;font-size:.9rem;font-weight:700;cursor:pointer;transition:background .2s;align-self:flex-end}
    .btn-primary:hover{background:#163d6b}
    .btn-primary:disabled{opacity:.5;cursor:not-allowed}
    .status-bar{padding:.55rem 1.5rem;font-size:.84rem;color:#4a5568;background:#edf2f7;border-bottom:1px solid #e2e8f0;display:flex;align-items:center;gap:1rem;min-height:2.2rem}
    .spinner{width:14px;height:14px;border:2px solid #0a2744;border-top-color:transparent;border-radius:50%;display:inline-block;animation:spin .7s linear infinite}
    @keyframes spin{to{transform:rotate(360deg)}}
    .badge{background:#0a2744;color:#fff;border-radius:12px;padding:.1rem .6rem;font-size:.78rem;font-weight:700}
    .err{color:#c53030}
    .table-wrap{overflow-x:auto;padding:1rem 1.5rem}
    table{width:100%;border-collapse:collapse;font-size:.84rem;background:#fff;border-radius:10px;box-shadow:0 1px 8px rgba(0,0,0,.07);overflow:hidden}
    thead th{background:#0a2744;color:#fff;padding:.6rem .75rem;text-align:center;white-space:nowrap;font-size:.78rem;letter-spacing:.4px;position:sticky;top:0;z-index:2}
    tbody tr:nth-child(even){background:#f7fafc}
    tbody tr:hover{background:#ebf4ff}
    tbody td{padding:.5rem .75rem;border-bottom:1px solid #e2e8f0;text-align:center;vertical-align:middle}
    tbody td.left{text-align:left}
    .no-data{padding:3rem;text-align:center;color:#718096;font-size:.95rem}
    .email-link{display:inline-block;padding:.25rem .7rem;background:#2b6cb0;color:#fff;border-radius:5px;font-size:.78rem;font-weight:700;text-decoration:none;white-space:nowrap;transition:background .2s}
    .email-link:hover{background:#2c5282}
    .no-email{color:#a0aec0;font-size:.8rem;font-style:italic}
    .bulk-bar{padding:.65rem 1.5rem;background:#fff;border-bottom:1px solid #e2e8f0;display:flex;flex-wrap:wrap;gap:.75rem;align-items:center}
    .bulk-bar label{font-size:.84rem;color:#4a5568;display:flex;align-items:center;gap:.4rem;cursor:pointer}
    .bulk-bar span{font-size:.84rem;color:#4a5568}
    .btn-green{padding:.45rem 1.1rem;background:#276749;color:#fff;border:none;border-radius:7px;font-size:.84rem;font-weight:700;cursor:pointer;transition:background .2s}
    .btn-green:hover{background:#22543d}
    .btn-green:disabled{opacity:.5;cursor:not-allowed}
    .btn-csv{padding:.45rem 1.1rem;background:#553c9a;color:#fff;border:none;border-radius:7px;font-size:.84rem;font-weight:700;cursor:pointer;transition:background .2s}
    .btn-csv:hover{background:#44337a}
    .modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.45);display:none;align-items:center;justify-content:center;z-index:100}
    .modal-overlay.open{display:flex}
    .modal{background:#fff;border-radius:14px;box-shadow:0 8px 40px rgba(0,0,0,.2);padding:2rem;max-width:620px;width:calc(100% - 2rem)}
    .modal h2{font-size:1.1rem;font-weight:800;color:#0a2744;margin-bottom:1rem}
    .modal textarea{width:100%;height:160px;border:1.5px solid #cbd5e0;border-radius:8px;padding:.65rem .9rem;font-size:.88rem;resize:vertical;outline:none;transition:border .2s;font-family:inherit}
    .modal textarea:focus{border-color:#0a2744}
    .modal-actions{display:flex;gap:.75rem;justify-content:flex-end;margin-top:1rem}
    .btn-cancel{padding:.5rem 1.1rem;background:#e2e8f0;color:#4a5568;border:none;border-radius:7px;font-size:.88rem;font-weight:700;cursor:pointer}
    .btn-send{padding:.5rem 1.3rem;background:#0a2744;color:#fff;border:none;border-radius:7px;font-size:.88rem;font-weight:700;cursor:pointer}
    .btn-send:hover{background:#163d6b}
  </style>
</head>
<body>
<div class="header">
  <h1>SHORES OF PANAMA &nbsp;·&nbsp; Guest Email Tool</h1>
  <div class="header-right">
    <a href="/admin" class="btn-sm btn-secondary">← Survey Admin</a>
    <a href="/admin?logout=1" class="btn-sm btn-secondary">Logout</a>
  </div>
</div>
<div class="controls">
  <div class="ctrl-group">
    <label>Start Date — From</label>
    <input type="date" id="startBegin" />
  </div>
  <div class="ctrl-group">
    <label>Start Date — To</label>
    <input type="date" id="startEnd" />
  </div>
  <button class="btn-primary" id="fetchBtn">Fetch Guests</button>
</div>
<div class="status-bar" id="statusBar">Enter a date range and click Fetch Guests.</div>
<div class="bulk-bar" id="bulkBar" style="display:none">
  <label><input type="checkbox" id="selectAll" /> Select All</label>
  <span id="selectedCount">0 selected</span>
  <button class="btn-green" id="openMailtoBtn" disabled>Open Mailto (selected)</button>
  <button class="btn-csv" id="exportCsvBtn">Download CSV</button>
</div>
<div class="table-wrap">
  <table id="guestTable" style="display:none">
    <thead>
      <tr>
        <th></th>
        <th>First Name</th>
        <th>Last Name</th>
        <th>Email</th>
        <th>Unit / Address</th>
        <th>Start Date</th>
        <th>End Date</th>
        <th>Pass Type</th>
        <th>Status</th>
        <th>Send Survey</th>
      </tr>
    </thead>
    <tbody id="guestBody"></tbody>
  </table>
  <div class="no-data" id="noData" style="display:none">No guest passes found for the selected date range.</div>
</div>
<div class="modal-overlay" id="modalOverlay">
  <div class="modal">
    <h2>Compose Survey Invitation</h2>
    <p style="font-size:.84rem;color:#4a5568;margin-bottom:.75rem">
      Edit the email body below. Subject and recipients are set automatically.
      <strong id="modalRecipCount"></strong>
    </p>
    <textarea id="emailBody"></textarea>
    <div class="modal-actions">
      <button class="btn-cancel" id="cancelModal">Cancel</button>
      <button class="btn-send" id="openMailtoFinal">Open in Email Client</button>
    </div>
  </div>
</div>
<script>
(function () {
  const SURVEY_URL = 'https://survey.shorescoa.com/go';
  const DEFAULT_BODY = `Dear {NAME},

Thank you for staying at Shores of Panama! We hope you had a wonderful visit.

We would love to hear about your experience. Please take a moment to complete our brief guest survey:

${SURVEY_URL}

Your feedback helps us continue to improve the property and services for all guests.

Thank you,
Shores of Panama COA`;

  let filteredRows = [];

  const fetchBtn        = document.getElementById('fetchBtn');
  const statusBar       = document.getElementById('statusBar');
  const guestTable      = document.getElementById('guestTable');
  const guestBody       = document.getElementById('guestBody');
  const noData          = document.getElementById('noData');
  const bulkBar         = document.getElementById('bulkBar');
  const selectAll       = document.getElementById('selectAll');
  const selectedCount   = document.getElementById('selectedCount');
  const openMailtoBtn   = document.getElementById('openMailtoBtn');
  const exportCsvBtn    = document.getElementById('exportCsvBtn');
  const modalOverlay    = document.getElementById('modalOverlay');
  const cancelModal     = document.getElementById('cancelModal');
  const openMailtoFinal = document.getElementById('openMailtoFinal');
  const emailBodyTA     = document.getElementById('emailBody');
  const modalRecipCount = document.getElementById('modalRecipCount');

  fetchBtn.addEventListener('click', async () => {
    const startBegin = document.getElementById('startBegin').value;
    const startEnd   = document.getElementById('startEnd').value;
    statusBar.innerHTML = '<span class="spinner"></span>&nbsp; Fetching from Symliv…';
    fetchBtn.disabled = true;
    guestTable.style.display = 'none';
    noData.style.display = 'none';
    bulkBar.style.display = 'none';
    try {
      let url = '/api/symliv-passes';
      const params = new URLSearchParams();
      if (startBegin) params.set('startBegin', startBegin);
      if (startEnd)   params.set('startEnd',   startEnd);
      if ([...params].length) url += '?' + params.toString();
      const resp = await fetch(url);
      const json = await resp.json();
      if (!json.ok) throw new Error(json.error || 'Unknown error');
      filteredRows = json.rows || [];
      renderTable(filteredRows);
      statusBar.innerHTML = `<span class="badge">${filteredRows.length}</span>&nbsp; guests found`;
    } catch (err) {
      statusBar.innerHTML = `<span class="err">Error: ${err.message}</span>`;
    } finally {
      fetchBtn.disabled = false;
    }
  });

  function renderTable(rows) {
    guestBody.innerHTML = '';
    if (!rows.length) {
      noData.style.display = 'block';
      guestTable.style.display = 'none';
      bulkBar.style.display = 'none';
      return;
    }
    rows.forEach((r, i) => {
      const hasEmail = !!r.email;
      const name     = (r.firstName + ' ' + r.lastName).trim() || 'Guest';
      const mailto   = hasEmail ? buildMailto([r], name) : '';
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td><input type="checkbox" class="row-check" data-idx="${i}" ${hasEmail ? '' : 'disabled title="No email"'} /></td>
        <td class="left">${esc(r.firstName)}</td>
        <td class="left">${esc(r.lastName)}</td>
        <td class="left">${hasEmail ? esc(r.email) : '<span class="no-email">no email</span>'}</td>
        <td>${esc(r.unit)}</td>
        <td>${esc(r.startDate)}</td>
        <td>${esc(r.endDate)}</td>
        <td>${esc(r.passType)}</td>
        <td>${esc(r.status)}</td>
        <td>${hasEmail ? '<a class="email-link" href="' + mailto + '" target="_blank">Send</a>' : '<span class="no-email">—</span>'}</td>
      `;
      guestBody.appendChild(tr);
    });
    guestTable.style.display = '';
    bulkBar.style.display = 'flex';
    selectAll.checked = false;
    updateSelectedCount();
    document.querySelectorAll('.row-check').forEach(cb => {
      cb.addEventListener('change', updateSelectedCount);
    });
  }

  function updateSelectedCount() {
    const checked = document.querySelectorAll('.row-check:checked');
    selectedCount.textContent = checked.length + ' selected';
    openMailtoBtn.disabled = checked.length === 0;
  }

  selectAll.addEventListener('change', () => {
    document.querySelectorAll('.row-check:not([disabled])').forEach(cb => {
      cb.checked = selectAll.checked;
    });
    updateSelectedCount();
  });

  function buildMailto(rows, nameHint) {
    const to    = rows.map(r => r.email).filter(Boolean).join(';');
    const subj  = encodeURIComponent("Shores of Panama \u2013 We'd Love Your Feedback!");
    const body  = encodeURIComponent(DEFAULT_BODY.replace('{NAME}', nameHint || 'Guest'));
    return 'mailto:' + to + '?subject=' + subj + '&body=' + body;
  }

  openMailtoBtn.addEventListener('click', () => {
    const checked  = [...document.querySelectorAll('.row-check:checked')];
    const selected = checked.map(cb => filteredRows[parseInt(cb.dataset.idx)]);
    const withEmail = selected.filter(r => r.email);
    if (!withEmail.length) return;
    modalRecipCount.textContent = '(' + withEmail.length + ' recipient' + (withEmail.length > 1 ? 's' : '') + ')';
    emailBodyTA.value = DEFAULT_BODY.replace('{NAME}', 'Guest');
    modalOverlay._selectedRows = withEmail;
    modalOverlay.classList.add('open');
  });

  cancelModal.addEventListener('click', () => { modalOverlay.classList.remove('open'); });
  modalOverlay.addEventListener('click', (e) => { if (e.target === modalOverlay) modalOverlay.classList.remove('open'); });

  openMailtoFinal.addEventListener('click', () => {
    const rows = modalOverlay._selectedRows || [];
    if (rows.length > 30) alert('Warning: More than 30 recipients. Your email client may truncate the mailto link.');
    const to   = rows.map(r => r.email).join(';');
    const subj = encodeURIComponent("Shores of Panama \u2013 We'd Love Your Feedback!");
    const body = encodeURIComponent(emailBodyTA.value);
    window.open('mailto:' + to + '?subject=' + subj + '&body=' + body, '_blank');
    modalOverlay.classList.remove('open');
  });

  exportCsvBtn.addEventListener('click', () => {
    if (!filteredRows.length) return;
    const headers = ['firstName','lastName','email','unit','startDate','endDate','passType','status','paid','registrationId','credentialNumber'];
    const lines   = [headers.join(',')];
    filteredRows.forEach(r => {
      lines.push(headers.map(h => '"' + String(r[h] ?? '').replace(/"/g, '""') + '"').join(','));
    });
    const blob = new Blob([lines.join('\r\n')], { type: 'text/csv' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'symliv-guests-' + new Date().toISOString().slice(0,10) + '.csv';
    a.click();
  });

  function esc(str) {
    return String(str ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
})();
</script>
</body>
</html>
