---
export const prerender = false;
const authed = Astro.cookies.get("admin_auth")?.value === "shores-admin-ok";
if (!authed) return Astro.redirect("/admin");
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Guest Email Tool Â· Shores of Panama</title>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:system-ui,sans-serif;background:#f0f4f8;color:#1a1a2e;min-height:100vh}
nav{background:#0d2461;color:#fff;padding:0 1.25rem;display:flex;align-items:center;justify-content:space-between;height:52px;position:sticky;top:0;z-index:100}
nav .brand{font-size:1rem;font-weight:700;letter-spacing:.03em}
nav .nav-right{display:flex;align-items:center;gap:.5rem}
.badge-pill{background:#2563eb;color:#fff;border-radius:999px;padding:.2rem .75rem;font-size:.8rem;font-weight:600;white-space:nowrap}
.badge-pill.sent-pill{background:#16a34a}
.badge-pill.unsent-pill{background:#dc2626}
.nav-btn{background:rgba(255,255,255,.15);color:#fff;border:none;border-radius:6px;padding:.35rem .8rem;font-size:.82rem;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center}
.nav-btn:hover{background:rgba(255,255,255,.28)}
main{max-width:1200px;margin:1.5rem auto;padding:0 1rem}
.controls{background:#fff;border-radius:10px;padding:1rem 1.25rem;display:flex;flex-wrap:wrap;gap:.6rem;align-items:center;box-shadow:0 1px 4px rgba(0,0,0,.08);margin-bottom:1rem}
.controls select{padding:.4rem .7rem;border:1px solid #cbd5e1;border-radius:6px;font-size:.85rem;background:#f8fafc}
.btn{padding:.4rem .95rem;border:none;border-radius:6px;font-size:.85rem;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:.35rem}
.btn-primary{background:#2563eb;color:#fff}.btn-primary:hover{background:#1d4ed8}
.btn-warning{background:#d97706;color:#fff}.btn-warning:hover{background:#b45309}
.btn-secondary{background:#64748b;color:#fff}.btn-secondary:hover{background:#475569}
.btn-info{background:#0891b2;color:#fff}.btn-info:hover{background:#0e7490}
.btn:disabled{opacity:.5;cursor:not-allowed}
.status-bar{background:#fff;border-radius:8px;padding:.6rem 1rem;font-size:.88rem;margin-bottom:.75rem;min-height:2.2rem;box-shadow:0 1px 3px rgba(0,0,0,.06);display:flex;align-items:center;gap:.5rem}
.filter-note{background:#fef9c3;border:1px solid #fde047;border-radius:8px;padding:.55rem 1rem;font-size:.83rem;color:#713f12;margin-bottom:.75rem;display:none}
.err{color:#dc2626;font-weight:600}
.bulk-bar{background:#1e3a8a;color:#fff;border-radius:8px;padding:.55rem 1rem;display:none;flex-wrap:wrap;align-items:center;gap:.5rem;margin-bottom:.75rem}
.bulk-bar span{font-size:.83rem;flex:1}
.table-wrap{background:#fff;border-radius:10px;overflow:auto;box-shadow:0 1px 4px rgba(0,0,0,.08)}
table{width:100%;border-collapse:collapse;font-size:.84rem}
thead th{background:#1e3a8a;color:#fff;padding:.6rem .75rem;text-align:left;font-weight:600;white-space:nowrap;position:sticky;top:0}
tbody tr:nth-child(even){background:#f8fafc}
tbody tr:hover{background:#eff6ff}
td{padding:.55rem .75rem;border-bottom:1px solid #e2e8f0;vertical-align:middle}
.badge-sent{background:#dcfce7;color:#166534;border-radius:999px;padding:.1rem .6rem;font-size:.75rem;font-weight:700}
.badge-unsent{background:#fee2e2;color:#991b1b;border-radius:999px;padding:.1rem .6rem;font-size:.75rem;font-weight:700}
.send-btn{background:#2563eb;color:#fff;border:none;border-radius:5px;padding:.3rem .7rem;font-size:.78rem;font-weight:600;cursor:pointer}
.send-btn:hover{background:#1d4ed8}
.send-btn:disabled{opacity:.45;cursor:not-allowed}
.no-email{color:#94a3b8;font-style:italic;font-size:.8rem}
#noData{display:none;text-align:center;padding:2rem;color:#64748b;font-size:.95rem}
.spinner{display:inline-block;width:14px;height:14px;border:2px solid #cbd5e1;border-top-color:#2563eb;border-radius:50%;animation:spin .6s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:999;align-items:center;justify-content:center}
.modal-overlay.open{display:flex}
.modal-box{background:#fff;border-radius:12px;padding:1.5rem 1.75rem;width:min(520px,95vw);box-shadow:0 8px 32px rgba(0,0,0,.25)}
.modal-box h3{font-size:1.05rem;margin-bottom:1rem;color:#1e3a8a}
.modal-box input[type="email"]{width:100%;padding:.5rem .75rem;border:1px solid #cbd5e1;border-radius:6px;font-size:.9rem;margin-bottom:.75rem}
.modal-footer{display:flex;justify-content:flex-end;gap:.5rem;margin-top:1rem}
</style>
</head>
<body>

<nav>
  <span class="brand">SHORES OF PANAMA &middot; Guest Email Tool</span>
  <div class="nav-right">
    <span class="badge-pill sent-pill"   id="navSent">â€” Sent</span>
    <span class="badge-pill unsent-pill" id="navUnsent">â€” Unsent</span>
    <a href="/admin" class="nav-btn">&#8592; Survey Admin</a>
    <a href="/admin?logout=1" class="nav-btn">Logout</a>
  </div>
</nav>

<main>
  <div class="controls">
    <button id="loadBtn" class="btn btn-primary">&#128100; Load Guests</button>
    <div style="display:flex;flex-direction:column;align-items:center;gap:1px"><button id="syncBtn" class="btn btn-warning">&#8635; Sync Symliv</button><small id="lastSyncText" style="color:#9ca3af;font-size:.68rem"></small></div>
    <button id="testBtn" class="btn btn-info">&#9993; Send Test Email</button>
    <select id="filterSel">
      <option value="unsent" selected>Not Sent</option>
      <option value="all">All Guests</option>
      <option value="sent">Sent</option>
    </select>
  </div>

  <div class="status-bar"  id="statusBar">Click <strong>Load Guests</strong> to begin, or <strong>Sync Symliv</strong> to pull new registrations.</div>
  <div class="filter-note" id="filterNote"></div>

  <div class="bulk-bar" id="bulkBar">
    <input type="checkbox" id="selectAll" title="Select all visible" />
    <span id="selectedCount">0 selected</span>
    <button class="btn btn-secondary" id="exportCsvBtn">&#128190; Download CSV</button>
  </div>

  <div class="table-wrap">
    <div id="noData">No guests to display.</div>
    <table id="guestTable" style="display:none">
      <thead>
        <tr>
          <th><input type="checkbox" id="selectAllHead" /></th>
          <th>Guest Name</th><th>Email</th><th>Unit / Address</th>
          <th>Arrival</th><th>Departure</th><th>Email Sent</th><th>Action</th>
        </tr>
      </thead>
      <tbody id="guestBody"></tbody>
    </table>
  </div>
</main>

<!-- Test Email Modal -->
<div class="modal-overlay" id="testModal">
  <div class="modal-box">
    <h3>&#9993; Send Test Survey Email</h3>
    <p style="font-size:.85rem;color:#475569;margin-bottom:.75rem">Sends a [TEST] copy via <strong>survey@shorescoa.com</strong> for verification.</p>
    <input type="email" id="testEmailInput" placeholder="recipient@example.com" />
    <div id="testResult" style="font-size:.84rem;min-height:1.2rem"></div>
    <div class="modal-footer">
      <button class="btn btn-secondary" id="cancelTest">Cancel</button>
      <button class="btn btn-info"      id="sendTestBtn">Send Test</button>
    </div>
  </div>
</div>

<script>
(function(){
  'use strict';
  const $ = id => document.getElementById(id);
  const loadBtn=$('loadBtn'), syncBtn=$('syncBtn'), testBtn=$('testBtn');
  const filterSel=$('filterSel'), statusBar=$('statusBar'), filterNote=$('filterNote');
  const bulkBar=$('bulkBar'), selectAll=$('selectAll'), selectAllHead=$('selectAllHead');
  const selectedCount=$('selectedCount'), exportCsvBtn=$('exportCsvBtn');
  const guestTable=$('guestTable'), guestBody=$('guestBody'), noData=$('noData');
  const navSent=$('navSent'), navUnsent=$('navUnsent');
  const testModal=$('testModal'), testEmailInput=$('testEmailInput');
  const cancelTest=$('cancelTest'), sendTestBtn=$('sendTestBtn'), testResult=$('testResult');

  let allGuests=[], visibleRows=[];

  function cutoff(){
    const d=new Date(); d.setDate(d.getDate()-2); return d.toISOString().slice(0,10);
  }

  function esc(s){ return String(s??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

  function sentBadge(v){
    return v==='yes'
      ? '<span class="badge-sent">&#10003; Sent</span>'
      : '<span class="badge-unsent">&#10007; Not Sent</span>';
  }

  function updateNavBadges(){
    navSent.textContent   = allGuests.filter(g=>g.email_sent==='yes').length+' Sent';
    navUnsent.textContent = allGuests.filter(g=>g.email_sent!=='yes').length+' Unsent';
  }

  function applyFilters(){
    const cut=cutoff(), mode=filterSel.value;
    const departed=allGuests.filter(g=>g.departure && g.departure<=cut);
    const hidden=allGuests.length-departed.length;
    filterNote.style.display=hidden>0?'block':'none';
    if(hidden>0) filterNote.textContent=`\u26a0 ${hidden} guest${hidden>1?'s':''} hidden \u2014 departed within the last 2 days. They appear automatically once eligible.`;
    visibleRows = mode==='sent'   ? departed.filter(g=>g.email_sent==='yes')
                : mode==='unsent' ? departed.filter(g=>g.email_sent!=='yes')
                : departed;
    renderTable(visibleRows);
    updateNavBadges();
  }

  filterSel.addEventListener('change',()=>{ if(allGuests.length) applyFilters(); });

  async function apiJson(url,opts){
    const r=await fetch(url,opts);
    const t=await r.text();
    try{return JSON.parse(t);}catch{throw new Error('API error '+r.status);}
  }

  loadBtn.addEventListener('click',async()=>{
    statusBar.innerHTML='<span class="spinner"></span>&nbsp; Loading\u2026';
    loadBtn.disabled=true; guestTable.style.display='none'; noData.style.display='none'; bulkBar.style.display='none';
    try{
      const d=await apiJson('/api/guests');
      if(!d.ok) throw new Error(d.error||'Load failed');
      allGuests=d.guests||[];
      applyFilters();
      statusBar.innerHTML=`Loaded <strong>${allGuests.length}</strong> total guests.`;
    }catch(e){statusBar.innerHTML=`<span class="err">Error: ${esc(e.message)}</span>`;}
    finally{loadBtn.disabled=false;}
  });

  syncBtn.addEventListener('click',async()=>{
    statusBar.innerHTML='<span class="spinner"></span>&nbsp; Syncing from Symliv\u2026';
    syncBtn.disabled=true;
    try{
      const d=await apiJson('/api/sync-guests',{method:'POST'});
      if(!d.ok) throw new Error(d.error||'Sync failed');
      statusBar.innerHTML=`&#10003; Sync complete \u2014 ${d.inserted??0} new guest${d.inserted!==1?'s':''} added.`;
      const r2=await apiJson('/api/guests');
      allGuests=r2.guests||[]; applyFilters(); try{var _t=new Date().toLocaleString('en-US',{month:'short',day:'numeric',year:'numeric',hour:'numeric',minute:'2-digit'});localStorage.setItem('shores_last_sync',_t);var _e=document.getElementById('lastSyncText');if(_e)_e.textContent='Last synced: '+_t;}catch(_){}
    }catch(e){statusBar.innerHTML=`<span class="err">Sync error: ${esc(e.message)}</span>`;}
    finally{syncBtn.disabled=false;}
  });

  function renderTable(rows){
    guestBody.innerHTML='';
    if(!rows.length){noData.style.display='block';guestTable.style.display='none';bulkBar.style.display='none';return;}
    noData.style.display='none'; guestTable.style.display=''; bulkBar.style.display='flex';
    rows.forEach((g,i)=>{
      const has=!!g.email, sent=g.email_sent==='yes';
      const tr=document.createElement('tr'); tr.dataset.idx=i;
      tr.innerHTML=`
        <td><input type="checkbox" class="row-check" data-idx="${i}" ${has?'':'disabled'}/></td>
        <td>${esc(g.guest_name)}</td>
        <td>${has?esc(g.email):'<span class="no-email">no email</span>'}</td>
        <td>${esc(g.unit)}</td>
        <td>${esc(g.arrival)}</td>
        <td>${esc(g.departure)}</td>
        <td id="sc-${g.id}">${sentBadge(g.email_sent)}</td>
        <td>${has?`<button class="send-btn" data-id="${g.id}" data-idx="${i}">${sent?'Resend':'Send'}</button>`:'&mdash;'}</td>`;
      guestBody.appendChild(tr);
    });
    document.querySelectorAll('.row-check').forEach(c=>c.addEventListener('change',updateSel));
    document.querySelectorAll('.send-btn').forEach(b=>b.addEventListener('click',onSend));
    selectAll.checked=false; selectAllHead.checked=false; updateSel();
  }

  function updateSel(){
    const n=document.querySelectorAll('.row-check:checked').length;
    selectedCount.textContent=n+' selected';
  }

  function syncChecks(v){
    document.querySelectorAll('.row-check:not([disabled])').forEach(c=>{c.checked=v;});
    updateSel();
  }
  selectAll.addEventListener('change',()=>syncChecks(selectAll.checked));
  selectAllHead.addEventListener('change',()=>{selectAll.checked=selectAllHead.checked;syncChecks(selectAllHead.checked);});

  async function onSend(e){
    const btn=e.currentTarget, id=parseInt(btn.dataset.id), idx=parseInt(btn.dataset.idx), g=visibleRows[idx];
    if(!g?.email) return;
    btn.disabled=true; btn.textContent='Sending\u2026';
    try{
      const d=await apiJson('/api/send-email',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({to:g.email,name:g.guest_name})});
      if(!d.ok) throw new Error(d.error||'Send failed');
      await apiJson('/api/guests',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({id,emailSent:'yes'})});
      g.email_sent='yes';
      const cell=$('sc-'+id); if(cell) cell.innerHTML=sentBadge('yes');
      btn.textContent='&#10003; Sent'; btn.disabled=false;
      updateNavBadges();
    }catch(err){
      btn.textContent='Retry'; btn.disabled=false;
      statusBar.innerHTML=`<span class="err">Send failed for ${esc(g.email)}: ${esc(err.message)}</span>`;
    }
  }

  exportCsvBtn.addEventListener('click',()=>{
    if(!visibleRows.length) return;
    const hdr=['id','guest_name','email','unit','arrival','departure','email_sent'];
    const lines=[hdr.join(','),...visibleRows.map(g=>hdr.map(h=>`"${String(g[h]??'').replace(/"/g,'""')}"`).join(','))];
    const a=document.createElement('a');
    a.href=URL.createObjectURL(new Blob([lines.join('\r\n')],{type:'text/csv'}));
    a.download='shores-guests-'+new Date().toISOString().slice(0,10)+'.csv'; a.click();
  });

  testBtn.addEventListener('click',()=>{testEmailInput.value='';testResult.textContent='';testModal.classList.add('open');testEmailInput.focus();});
  cancelTest.addEventListener('click',()=>testModal.classList.remove('open'));
  testModal.addEventListener('click',e=>{if(e.target===testModal)testModal.classList.remove('open');});

  sendTestBtn.addEventListener('click',async()=>{
    const addr=testEmailInput.value.trim();
    if(!addr){testResult.innerHTML='<span class="err">Please enter an email address.</span>';return;}
    sendTestBtn.disabled=true; testResult.innerHTML='<span class="spinner"></span>&nbsp; Sending\u2026';
    try{
      const d=await apiJson('/api/send-email',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({to:addr,name:'Test Guest',test:true})});
      if(!d.ok) throw new Error(d.error||'Failed');
      testResult.innerHTML=`<span style="color:#16a34a">&#10003; Test sent to <strong>${esc(addr)}</strong></span>`;
    }catch(err){
      testResult.innerHTML=`<span class="err">&#10007; ${esc(err.message)}</span>`;
    }finally{sendTestBtn.disabled=false;}
  });

  try{var _ls=localStorage.getItem('shores_last_sync');var _e=document.getElementById('lastSyncText');if(_ls&&_e)_e.textContent='Last synced: '+_ls;}catch(_){}  loadBtn.click();
})();
</script>
</body>
</html>

