---
// src/pages/check.astro
export const prerender = false;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SOP Access Checker</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --navy-900:#0a1f44; --navy-800:#0d2650; --navy-700:#112244;
      --navy-600:#1a3366; --navy-500:#254a82; --navy-400:#3a6199;
      --navy-300:#5a81b3; --navy-200:#8aaad4; --navy-100:#c0d4eb;
      --gold-400:#c9a84c; --gold-300:#d4ba6f;
      --green-700:#15803d; --green-600:#16a34a; --green-100:#dcfce7;
      --red-700:#b91c1c;   --red-600:#dc2626;   --red-100:#fee2e2;
      --amber-600:#d97706; --amber-100:#fef3c7;
    }
    body { font-family: -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; background:var(--navy-900); min-height:100vh; color:#fff; }
    @keyframes shake { 0%,100%{transform:translateX(0)} 10%,30%,50%,70%,90%{transform:translateX(-6px)} 20%,40%,60%,80%{transform:translateX(6px)} }
    @keyframes spin  { from{transform:rotate(0deg)} to{transform:rotate(360deg)} }
    @keyframes fadeIn{ from{opacity:0;transform:translateY(12px)} to{opacity:1;transform:translateY(0)} }
    @keyframes pulseGlow { 0%,100%{box-shadow:0 0 0 0 rgba(201,168,76,.3)} 50%{box-shadow:0 0 20px 6px rgba(201,168,76,.15)} }
    .shake   { animation:shake .5s ease-in-out; }
    .fade-in { animation:fadeIn .35s ease-out; }

    .page { min-height:100vh; display:flex; flex-direction:column; }

    header {
      background:linear-gradient(135deg,var(--navy-800),var(--navy-700));
      border-bottom:2px solid var(--gold-400);
      padding:16px 24px; display:flex; align-items:center; justify-content:space-between; gap:16px;
    }
    .header-brand { display:flex; align-items:center; gap:12px; }
    .header-logo  { width:48px;height:48px;background:var(--gold-400);border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:18px;color:var(--navy-900);flex-shrink:0; }
    .header-title { font-size:20px;font-weight:700; }
    .header-sub   { font-size:12px;color:var(--navy-200);margin-top:2px; }
    .header-meta  { text-align:right;font-size:11px;color:var(--navy-300);line-height:1.5; }

    main { flex:1;display:flex;align-items:flex-start;justify-content:center;padding:32px 16px; }
    .card { background:var(--navy-800);border:1px solid var(--navy-600);border-radius:16px;padding:32px 28px;width:100%;max-width:480px;box-shadow:0 20px 60px rgba(0,0,0,.4); }

    /* LOGIN */
    .login-label { font-size:13px;font-weight:600;color:var(--navy-200);margin-bottom:8px;letter-spacing:.05em;text-transform:uppercase; }
    .login-input { width:100%;padding:12px 16px;background:var(--navy-700);border:1.5px solid var(--navy-500);border-radius:8px;color:#fff;font-size:16px;outline:none;transition:border-color .2s; }
    .login-input:focus { border-color:var(--gold-400);animation:pulseGlow 2s ease-in-out infinite; }
    .login-input::placeholder { color:var(--navy-300); }
    .login-btn { margin-top:16px;width:100%;padding:14px;background:var(--gold-400);color:var(--navy-900);font-weight:700;font-size:15px;letter-spacing:.04em;border:none;border-radius:8px;cursor:pointer;transition:background .2s; }
    .login-btn:hover { background:var(--gold-300); }
    .login-error { margin-top:12px;padding:10px 14px;background:#b91c1c;border-radius:8px;font-size:13px;display:none; }

    /* CHECKER */
    #checker-section { display:none; }
    .section-label { font-size:11px;font-weight:700;color:var(--navy-300);letter-spacing:.08em;text-transform:uppercase;margin-bottom:10px; }
    .input-row { display:flex;gap:8px;margin-bottom:12px; }
    .rfid-input { flex:1;padding:14px 16px;background:var(--navy-700);border:2px solid var(--navy-500);border-radius:10px;color:#fff;font-size:22px;font-weight:700;font-family:'Courier New',monospace;letter-spacing:.08em;outline:none;transition:border-color .2s; }
    .rfid-input:focus { border-color:var(--gold-400); }
    .rfid-input::placeholder { color:var(--navy-400);font-size:16px;font-weight:400;letter-spacing:0; }
    .btn { padding:10px 18px;border-radius:8px;border:none;cursor:pointer;font-weight:600;font-size:14px;transition:opacity .15s,transform .1s; }
    .btn:active { transform:scale(.97); }
    .btn-clear  { background:var(--navy-600);color:var(--navy-100); }
    .btn-check  { background:var(--gold-400);color:var(--navy-900);padding:10px 22px; }
    .btn-check:hover   { background:var(--gold-300); }
    .btn-check:disabled { opacity:.5;cursor:not-allowed; }

    /* KEYPAD */
    .keypad { display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:20px; }
    .key { aspect-ratio:1.4;border:none;border-radius:10px;background:var(--navy-700);color:#fff;font-size:20px;font-weight:600;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .1s,transform .1s;user-select:none; }
    .key:hover  { background:var(--navy-600); }
    .key:active { background:var(--navy-500);transform:scale(.94); }
    .key-del   { background:var(--navy-600); }
    .key-check { background:var(--gold-400);color:var(--navy-900); }
    .key-check:hover { background:var(--gold-300); }

    /* RESULT */
    #result-box { border-radius:12px;padding:20px 18px;display:none; }
    #result-box.valid   { background:var(--green-100);border:2px solid var(--green-600);color:var(--green-700); animation:fadeIn .35s ease-out; }
    #result-box.invalid { background:var(--red-100);  border:2px solid var(--red-600);  color:var(--red-700);   animation:fadeIn .35s ease-out; }
    #result-box.error   { background:var(--amber-100);border:2px solid var(--amber-600);color:#92400e;          animation:fadeIn .35s ease-out; }
    .result-icon  { font-size:36px;margin-bottom:8px; }
    .result-title { font-size:22px;font-weight:800;margin-bottom:4px; }
    .result-sub   { font-size:13px;opacity:.8;margin-bottom:12px; }
    .result-countdown { font-size:12px;opacity:.6; }
    .btn-retry { margin-top:10px;padding:8px 16px;border-radius:6px;border:none;cursor:pointer;font-weight:600;font-size:13px; }
    .btn-retry.valid   { background:var(--green-600);color:#fff; }
    .btn-retry.invalid { background:var(--red-600);  color:#fff; }
    .btn-retry.error   { background:var(--amber-600);color:#fff; }

    hr.divider { border:none;border-top:1px solid var(--navy-600);margin:20px 0; }
    footer { padding:12px 24px;text-align:center;font-size:11px;color:var(--navy-400);border-top:1px solid var(--navy-700); }
  </style>
</head>
<body>
<div class="page">

  <header>
    <div class="header-brand">
      <div class="header-logo">SOP</div>
      <div>
        <div class="header-title">SOP Access Checker</div>
        <div class="header-sub">Staff Access Verification System</div>
      </div>
    </div>
    <div class="header-meta">IT: locks@shoresofpanama-hoa.com<br>v1.2 | Aug 2026 · Shores of Panama HOA</div>
  </header>

  <main>
    <div class="card">

      <!-- LOGIN -->
      <section id="login-section">
        <div class="login-label">Staff Password</div>
        <input id="pw-input" class="login-input" type="password" placeholder="Enter staff password…" autocomplete="current-password" />
        <button class="login-btn" id="login-btn">SIGN IN</button>
        <div class="login-error" id="login-error">⚠ Incorrect password. Please try again.</div>
      </section>

      <!-- CHECKER -->
      <section id="checker-section">
        <div class="section-label">Scan or Enter RFID / Card Number</div>
        <div class="input-row">
          <input id="rfid-input" class="rfid-input" type="text" inputmode="numeric" pattern="[0-9]*"
                 placeholder="Card number…" maxlength="20" autocomplete="off" />
          <button class="btn btn-clear" id="clear-btn">CLEAR</button>
          <button class="btn btn-check" id="check-btn">CHECK</button>
        </div>

        <div class="keypad" id="keypad">
          <button class="key" data-v="1">1</button>
          <button class="key" data-v="2">2</button>
          <button class="key" data-v="3">3</button>
          <button class="key" data-v="4">4</button>
          <button class="key" data-v="5">5</button>
          <button class="key" data-v="6">6</button>
          <button class="key" data-v="7">7</button>
          <button class="key" data-v="8">8</button>
          <button class="key" data-v="9">9</button>
          <button class="key" data-v="0">0</button>
          <button class="key key-del" id="del-btn" aria-label="Backspace">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 4H8l-7 8 7 8h13a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2z"/>
              <line x1="18" y1="9" x2="12" y2="15"/><line x1="12" y1="9" x2="18" y2="15"/>
            </svg>
          </button>
          <button class="key key-check" id="keypad-check-btn" aria-label="Check">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
          </button>
        </div>

        <hr class="divider" />

        <div id="result-box">
          <div class="result-icon" id="result-icon"></div>
          <div class="result-title" id="result-title"></div>
          <div class="result-sub" id="result-sub"></div>
          <button class="btn-retry" id="retry-btn">TRY AGAIN</button>
          <div class="result-countdown" id="result-countdown"></div>
        </div>
      </section>

    </div>
  </main>

  <footer>Shores of Panama HOA — Internal Staff Tool — Not for public use</footer>
</div>

<script is:inline>
(function () {
  'use strict';
  var STAFF_PASSWORD = 'Shores9900!';
  var SESSION_KEY    = 'sop_rfid_auth';
  var AUTO_RESET_SEC = 5;

  var loginSection    = document.getElementById('login-section');
  var checkerSection  = document.getElementById('checker-section');
  var pwInput         = document.getElementById('pw-input');
  var loginBtn        = document.getElementById('login-btn');
  var loginError      = document.getElementById('login-error');
  var rfidInput       = document.getElementById('rfid-input');
  var clearBtn        = document.getElementById('clear-btn');
  var checkBtn        = document.getElementById('check-btn');
  var delBtn          = document.getElementById('del-btn');
  var keypadCheckBtn  = document.getElementById('keypad-check-btn');
  var resultBox       = document.getElementById('result-box');
  var resultIcon      = document.getElementById('result-icon');
  var resultTitle     = document.getElementById('result-title');
  var resultSub       = document.getElementById('result-sub');
  var retryBtn        = document.getElementById('retry-btn');
  var resultCountdown = document.getElementById('result-countdown');
  var keypad          = document.getElementById('keypad');
  var resetTimer      = null;

  try { if (sessionStorage.getItem(SESSION_KEY) === '1') showChecker(); } catch(e) {}

  loginBtn.addEventListener('click', doLogin);
  pwInput.addEventListener('keydown', function(e){ if(e.key==='Enter') doLogin(); });

  function doLogin() {
    if (pwInput.value === STAFF_PASSWORD) {
      try { sessionStorage.setItem(SESSION_KEY, '1'); } catch(e) {}
      loginError.style.display = 'none';
      showChecker();
    } else {
      loginError.style.display = 'block';
      pwInput.value = '';
      pwInput.classList.add('shake');
      setTimeout(function(){ pwInput.classList.remove('shake'); }, 600);
    }
  }

  function showChecker() {
    loginSection.style.display  = 'none';
    checkerSection.style.display = 'block';
    rfidInput.focus();
  }

  keypad.addEventListener('click', function(e) {
    var btn = e.target.closest('[data-v]');
    if (btn) { rfidInput.value += btn.dataset.v; rfidInput.focus(); }
  });
  delBtn.addEventListener('click', function(){ rfidInput.value = rfidInput.value.slice(0,-1); rfidInput.focus(); });
  clearBtn.addEventListener('click', resetUI);
  retryBtn.addEventListener('click', resetUI);
  keypadCheckBtn.addEventListener('click', triggerCheck);
  checkBtn.addEventListener('click', triggerCheck);
  rfidInput.addEventListener('keydown', function(e){ if(e.key==='Enter') triggerCheck(); });

  function triggerCheck() {
    var q = rfidInput.value.trim();
    if (!q) { rfidInput.classList.add('shake'); setTimeout(function(){ rfidInput.classList.remove('shake'); }, 600); return; }
    doCheck(q);
  }

  function doCheck(q) {
    checkBtn.disabled = true;
    keypadCheckBtn.disabled = true;
    showResult('error', '⟳', 'Checking…', 'Contacting PDK.io access control system…', true);

    fetch('/api/pdk-check?q=' + encodeURIComponent(q))
      .then(function(r){ return r.json(); })
      .then(function(data) {
        if (data.ok === true) {
          showResult('valid', '✓', 'VALID ACCESS', 'Card ' + q + ' is active in the system.');
        } else if (data.notFound) {
          showResult('invalid', '✗', 'NOT FOUND', 'Card ' + q + ' is not registered or inactive.');
        } else {
          showResult('error', '⚠', 'SYSTEM UNAVAILABLE', data.error || 'Could not reach PDK.io — contact IT.');
        }
      })
      .catch(function(){ showResult('error', '⚠', 'NETWORK ERROR', 'Could not reach the server. Check your connection.'); });
  }

  function showResult(type, icon, title, sub, loading) {
    resultBox.className = '';
    if (loading) {
      resultIcon.textContent = '⟳'; resultTitle.textContent = title; resultSub.textContent = sub;
      resultBox.className = 'error'; resultBox.style.display = 'block';
      resultCountdown.textContent = ''; retryBtn.style.display = 'none'; return;
    }
    resultIcon.textContent  = icon;
    resultTitle.textContent = title;
    resultSub.textContent   = sub;
    var cls = type === 'valid' ? 'valid' : type === 'invalid' ? 'invalid' : 'error';
    resultBox.className = cls; resultBox.style.display = 'block';
    retryBtn.className = 'btn-retry ' + cls; retryBtn.style.display = 'inline-block';
    checkBtn.disabled = false; keypadCheckBtn.disabled = false;

    var secs = AUTO_RESET_SEC;
    resultCountdown.textContent = 'Auto-reset in ' + secs + '…';
    clearTimeout(resetTimer);
    resetTimer = setInterval(function() {
      secs--;
      if (secs <= 0) { clearInterval(resetTimer); resetUI(); }
      else { resultCountdown.textContent = 'Auto-reset in ' + secs + '…'; }
    }, 1000);
  }

  function resetUI() {
    clearInterval(resetTimer);
    rfidInput.value = ''; resultBox.style.display = 'none'; resultBox.className = '';
    resultCountdown.textContent = ''; checkBtn.disabled = false; keypadCheckBtn.disabled = false;
    rfidInput.focus();
  }
})();
</script>
</body>
</html>
