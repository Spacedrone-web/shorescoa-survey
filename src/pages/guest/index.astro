---
Astro.response.headers.set("Cache-Control", "no-cache, no-store, must-revalidate");
Astro.response.headers.set("Pragma", "no-cache");
Astro.response.headers.set("Expires", "0");

// Cloudflare D1 binding
const DB = (Astro.locals as any).runtime.env.DB;

// ============================================================
// CST Helpers
// ============================================================

function getCSTDate(offsetDays = 0) {
  const d = new Date();
  d.setDate(d.getDate() + offsetDays);
  return d.toLocaleDateString("en-CA", { timeZone: "America/Chicago" });
}

const TODAY = getCSTDate(0);
const YESTERDAY = getCSTDate(-1);
const PLUS5 = getCSTDate(5);

function toCSTDate(dateStr) {
  if (!dateStr) return "";
  if (/^\d{4}-\d{2}-\d{2}$/.test(dateStr)) return dateStr;
  return new Date(dateStr).toLocaleDateString("en-CA", {
    timeZone: "America/Chicago"
  });
}

function toCSTDateTime(dateStr) {
  if (!dateStr) return { date: "", time: "" };
  const d = new Date(dateStr);
  return {
    date: d.toLocaleDateString("en-CA", { timeZone: "America/Chicago" }),
    time: d.toLocaleTimeString("en-US", {
      timeZone: "America/Chicago",
      hour: "numeric",
      minute: "2-digit"
    })
  };
}

// ============================================================
// STEP 1 — Fetch Registration Fee rows in 6‑day window
// ============================================================

const feeRows = await DB.prepare(`
  SELECT
    passId,
    registrationId,
    unit,
    substr(arrivalDate, 1, 10) AS arrivalDate,
    substr(departureDate, 1, 10) AS departureDate,
    createdAt,
    guest_firstName,
    guest_lastName,
    passType,
    passInfo_name,
    externalCredentialNumber,
    paid
  FROM guest_reg
  WHERE passInfo_name = 'Registration Fee'
    AND substr(arrivalDate, 1, 10) <= ?
    AND substr(departureDate, 1, 10) >= ?
`).bind(YESTERDAY, PLUS5).all();

let worklist = [];

// ============================================================
// STEP 2 — Process each Registration Fee row
// ============================================================

for (const fee of feeRows.results || []) {

  const regId = fee.registrationId;
  const unit = fee.unit;

  // Paid logic
  const isPaid = (fee.paid === "paid" || fee.paid === "ach-pending");
  const isUnpaidWithRFID = (fee.paid === "unpaid" &&
    (fee.externalCredentialNumber || "").trim() !== "");

  if (!isPaid && !isUnpaidWithRFID) {
    continue; // unpaid with no RFID → ignore
  }

  // Fetch wristbands
  const wbRows = await DB.prepare(`
    SELECT *
    FROM guest_reg
    WHERE registrationId = ?
      AND passInfo_name = 'Guest Wristband'
  `).bind(regId).all();

  const wristbands = wbRows.results || [];

  // RFID completeness check
  const feeRFID = (fee.externalCredentialNumber || "").trim() !== "";
  const wbRFID = wristbands.filter(w => (w.externalCredentialNumber || "").trim() !== "");
  const wbBlank = wristbands.filter(w => (w.externalCredentialNumber || "").trim() === "");

  const allWBComplete = (wbBlank.length === 0);
  const isComplete = feeRFID && allWBComplete;

  if (isComplete) {
    continue; // fully complete → do not show
  }

  // Misassigned wristband detection (same 6‑day window)
  let misassigned = [];
  if (feeRFID && wbBlank.length > 0 && wbRFID.length > 0) {
    const otherRows = await DB.prepare(`
      SELECT *
      FROM guest_reg
      WHERE unit = ?
        AND passInfo_name = 'Guest Wristband'
        AND externalCredentialNumber IS NOT NULL
        AND externalCredentialNumber != ''
        AND substr(arrivalDate, 1, 10) <= ?
        AND substr(departureDate, 1, 10) >= ?
    `).bind(unit, YESTERDAY, PLUS5).all();

    misassigned = otherRows.results || [];
  }

  // Build display rows
  worklist.push({
    type: "fee",
    unit,
    fee,
    wristbands,
    misassigned
  });
}

// ============================================================
// SORTING — unit → paid → unpaid-with-RFID
// ============================================================

worklist.sort((a, b) => {
  const unitA = parseInt(a.unit, 10);
  const unitB = parseInt(b.unit, 10);
  if (unitA !== unitB) return unitA - unitB;

  const paidA = (a.fee.paid === "paid" || a.fee.paid === "ach-pending") ? 0 : 1;
  const paidB = (b.fee.paid === "paid" || b.fee.paid === "ach-pending") ? 0 : 1;
  return paidA - paidB;
});

const visibleCount = worklist.length;
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>RFID Worklist — Guest Reservations</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/x-icon" href="/favicon-circle-v3.ico">

  <style>
	body {
	  font-family: Arial, sans-serif;
	  background: #0d1b2a;
	  color: #ffffff;
	  font-size: 13px;
	}

	.guest-banner {
	  width: 100%;
	  background: #1b263b;
	  padding: 10px 15px;
	  display: flex;
	  justify-content: space-between;
	  border-bottom: 3px solid #415a77;
	}

	.guest-banner-logo { height: 40px; }

	.guest-banner-title {
	  font-size: 22px;
	  font-weight: bold;
	  text-align: center;
	}

	.nav-btn, .logout-btn {
	  padding: 6px 10px;
	  border-radius: 4px;
	  border: 1px solid #ffffff;
	  background: transparent;
	  color: #ffffff;
	  cursor: pointer;
	  font-weight: bold;
	  font-size: 12px;
	}

	h2 {
	  margin: 15px;
	  font-size: 18px;
	}

	table {
	  width: 100%;
	  border-collapse: collapse;
	  margin: 0 15px 20px 15px;
	  background: #1b263b;
	  border-radius: 6px;
	  font-size: 12px;
	}

	thead th {
	  background: #415a77;
	  padding: 8px;
	  border-right: 1px solid #778da9;
	}

	tbody td {
	  padding: 6px;
	  border-bottom: 1px solid #415a77;
	}

    .incomplete { background-color: #8b0000 !important; }
    .misassigned { background-color: #8b4500 !important; }
  </style>
</head>

<body>

  <div class="guest-banner">
    <img src="/sop_logo.jpg" class="guest-banner-logo" />
    <div class="guest-banner-title">RFID Worklist</div>
    <button class="nav-btn" onclick="window.location.href='/status'">Return to Status</button>
  </div>

  <h2>RFID Assignment Worklist</h2>

  <div style="margin: 0 25px 10px 25px;">
    Showing {visibleCount} registrations needing RFID work
  </div>

  <table>
    <thead>
      <tr>
        <th>Unit</th>
        <th>Guest</th>
        <th>Type</th>
        <th>Paid</th>
        <th>RFID</th>
        <th>Arrival</th>
        <th>Departure</th>
      </tr>
    </thead>

    <tbody>
      {worklist.map((entry) => {
        const fee = entry.fee;
        const created = toCSTDateTime(fee.createdAt);

        return (
          <>
            <tr class="incomplete">
              <td>{fee.unit}</td>
              <td>{fee.guest_firstName} {fee.guest_lastName}</td>
              <td>Registration Fee</td>
              <td>{fee.paid}</td>
              <td>{fee.externalCredentialNumber || "(missing)"}</td>
              <td>{toCSTDate(fee.arrivalDate)}</td>
              <td>{toCSTDate(fee.departureDate)}</td>
            </tr>

            {entry.wristbands
              .sort((a, b) => {
                const aRFID = (a.externalCredentialNumber || "").trim() !== "";
                const bRFID = (b.externalCredentialNumber || "").trim() !== "";
                return aRFID === bRFID ? 0 : aRFID ? -1 : 1;
              })
              .map((wb) => (
                <tr class={wb.externalCredentialNumber ? "" : "incomplete"}>
                  <td>{fee.unit}</td>
                  <td>{wb.guest_firstName} {wb.guest_lastName}</td>
                  <td>Guest Wristband</td>
                  <td>{wb.paid}</td>
                  <td>{wb.externalCredentialNumber || "(missing)"}</td>
                  <td>{toCSTDate(wb.arrivalDate)}</td>
                  <td>{toCSTDate(wb.departureDate)}</td>
                </tr>
              ))}

            {entry.misassigned.map((wb) => (
              <tr class="misassigned">
                <td>{fee.unit}</td>
                <td>{wb.guest_firstName} {wb.guest_lastName}</td>
                <td>Possible Misassigned WB</td>
                <td>{wb.paid}</td>
                <td>{wb.externalCredentialNumber}</td>
                <td>{toCSTDate(wb.arrivalDate)}</td>
                <td>{toCSTDate(wb.departureDate)}</td>
              </tr>
            ))}
          </>
        );
      })}

      {worklist.length === 0 && (
        <tr>
          <td colspan="7" style="text-align:center; padding: 15px;">
            All registrations are fully assigned — no RFID work needed.
          </td>
        </tr>
      )}
    </tbody>
  </table>

</body>
</html>
