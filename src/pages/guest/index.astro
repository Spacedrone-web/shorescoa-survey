---
Astro.response.headers.set("Cache-Control", "no-cache, no-store, must-revalidate");
Astro.response.headers.set("Pragma", "no-cache");
Astro.response.headers.set("Expires", "0");

// Force CST/CDT for date defaults
const CST_TODAY = new Date().toLocaleDateString("en-CA", { timeZone: "America/Chicago" });

// D1 binding (Cloudflare Pages)
const DB = (Astro.locals as any).runtime.env.DB;

// Read query params
const url = new URL(Astro.request.url);
const fromParam = url.searchParams.get("from");
const toParam = url.searchParams.get("to");
const showAllParam = url.searchParams.get("showAll");

const fromDate = fromParam || CST_TODAY;
const toDate = toParam || CST_TODAY;
const showAll = showAllParam === "on" || showAllParam === "1";

// Query D1.guest_reg
const rows = await DB.prepare(`
  SELECT
    passId,
    registrationId,
    unit,
    substr(arrivalDate, 1, 10) AS arrivalDate,
    substr(departureDate, 1, 10) AS departureDate,
    createdAt,
    guest_firstName,
    guest_lastName,
    passType,
    passInfo_name,
    externalCredentialNumber,
	paid
  FROM guest_reg
  WHERE substr(arrivalDate, 1, 10) >= ?
    AND substr(arrivalDate, 1, 10) <= ?
  ORDER BY arrivalDate, unit, createdAt
`).bind(fromDate, toDate).all();

function groupByUnit(rows) {
  const map = new Map();
  for (const r of rows) {
    if (!map.has(r.unit)) map.set(r.unit, []);
    map.get(r.unit).push(r);
  }
  return map;
}

const grouped = groupByUnit(rows.results || []);

// Format helpers (CST)
function toCSTDate(dateStr) {
  if (!dateStr) return "";
  const d = new Date(dateStr);
  return d.toLocaleDateString("en-US", { timeZone: "America/Chicago" });
}

function toCSTDateTime(dateStr) {
  if (!dateStr) return { date: "", time: "" };
  const d = new Date(dateStr);
  return {
    date: d.toLocaleDateString("en-US", { timeZone: "America/Chicago" }),
    time: d.toLocaleTimeString("en-US", {
      timeZone: "America/Chicago",
      hour: "numeric",
      minute: "2-digit"
    })
  };
}

// Filtering logic (matches James' rules exactly)
function shouldDisplay(row, showAllFlag) {
  const unitRows = grouped.get(row.unit) || [];

  const registrationFeeRow = unitRows.find(
    r => r.passInfo_name === "Registration Fee"
  );

  const wristbandRows = unitRows.filter(
    r => r.passInfo_name.toLowerCase().includes("wrist")
  );

  const regRFID = registrationFeeRow?.externalCredentialNumber?.trim() || "";
  const wristRFIDs = wristbandRows.map(
    r => r.externalCredentialNumber?.trim() || ""
  );

  const wristAnyOccupied = wristRFIDs.some(r => r !== "");
  const wristAnyBlank = wristRFIDs.some(r => r === "");

  // -----------------------------
  // DEFAULT VIEW (Show All OFF)
  // -----------------------------
  if (!showAllFlag) {
    // Rule 1: Reg occupied + Wrist blank
    if (regRFID !== "" && wristAnyBlank) return true;

    // Rule 2: Reg blank + Wrist blank
    if (regRFID === "" && wristAnyBlank) return true;

    return false;
  }

  // -----------------------------
  // SHOW ALL VIEW (Show All ON)
  // -----------------------------
  // Rule 1: Reg occupied + Wrist blank
  if (regRFID !== "" && wristAnyBlank) return true;

  // Rule 2: Reg blank + Wrist blank
  if (regRFID === "" && wristAnyBlank) return true;

  // Rule 3: Reg occupied + Wrist occupied
  if (regRFID !== "" && wristAnyOccupied) return true;

  return false;
}

const filteredRows = (rows?.results || []).filter((row) =>
  shouldDisplay(row, showAll)
);

const totalCount = rows?.results?.length || 0;
const visibleCount = filteredRows.length;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Guest Registration Summary</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/x-icon" href="/favicon-circle-v3.ico">

  <style>
    /* RESET */
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: Arial, sans-serif;
      background: #f5f5f5;
    }

    /* HEADER */
    .guest-banner {
      width: 100%;
      background: #1e73be;
      color: white;
      padding: 18px 25px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 4px solid #155a94;
    }

    .banner-left {
      display: flex;
      align-items: center;
    }

    .guest-banner-logo {
      height: 60px;
    }

    .banner-center {
      flex: 1;
      display: flex;
      justify-content: center;
    }

    .guest-banner-title {
      font-size: 34px;
      font-weight: bold;
      white-space: nowrap;
      text-align: center;
    }

    .banner-right {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 10px;
      width: 200px;
    }

    .parking-banner {
      background: rgba(0,0,0,0.25);
      padding: 8px 16px;
      border-radius: 6px;
      font-size: 18px;
      font-weight: bold;
      white-space: nowrap;
    }

    .nav-btn,
    .logout-btn {
      width: 100%;
      text-align: center;
      padding: 8px 16px;
      border-radius: 6px;
      font-weight: bold;
      cursor: pointer;
      font-size: 14px;
      border: none;
    }

    .nav-btn {
      background: #0f766e;
      color: white;
    }

    .logout-btn {
      background: #c0392b;
      color: white;
    }

    /* PAGE CONTENT */
    h2 {
      margin: 25px;
      font-size: 26px;
      color: #333;
    }

    .top-bar { margin: 0 25px 20px 25px; }

    .left-controls label { margin-right: 6px; font-weight: bold; }
    .left-controls input[type="date"] { margin-right: 12px; padding: 4px 6px; }

    .btn-blue {
      background: #1e73be;
      color: white;
      border: none;
      padding: 8px 14px;
      border-radius: 6px;
      cursor: pointer;
      margin-right: 8px;
    }

    .counts {
      margin: 0 25px 10px 25px;
      font-size: 14px;
      color: #555;
    }

    /* TABLE */
    .table-container {
      margin: 0 25px 40px 25px;
      background: white;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.15);
      overflow: hidden;
    }

    table { width: 100%; border-collapse: collapse; font-size: 15px; }
    thead th {
      background: #1e73be;
      color: white;
      padding: 12px 10px;
      border-right: 2px solid #155a94;
      font-weight: bold;
      text-align: left;
    }

    tbody td {
      padding: 10px;
      border-right: 1px solid #d0d0d0;
      border-bottom: 1px solid #dcdcdc;
      font-size: 14px;
    }

    tbody tr:nth-child(even) { background: #f7f9fc; }
    tbody tr:hover { background: #e8f1ff; }
  </style>
</head>

<body>

  <!-- HEADER -->
  <div class="guest-banner">
    <div class="banner-left">
      <img src="/sop_logo.jpg" class="guest-banner-logo" />
    </div>

    <div class="banner-center">
      <div class="guest-banner-title">Guest Reservations</div>
    </div>

    <div class="banner-right">
      <button class="nav-btn" onclick="window.location.href='/status'">
        Return to Status
      </button>

      <button class="logout-btn" onclick="
        document.cookie = 'sop_auth=; Max-Age=0; path=/';
        window.location.href='https://www.google.com/';
      ">
        Logout
      </button>
    </div>
  </div>

  <!-- PAGE CONTENT -->
  <h2>Guest Registration Summary</h2>

  <div class="top-bar">
    <form class="left-controls" method="GET">
      <label>From:</label>
      <input type="date" name="from" value={fromDate} />

      <label>To:</label>
      <input type="date" name="to" value={toDate} />

      <input type="checkbox" name="showAll" checked={showAll} />
      <label>Show all</label>

      <button type="submit" class="btn-blue">Search</button>
      <button type="submit" class="btn-blue">Refresh</button>

      <button
        type="button"
        class="btn-blue"
        onclick="
          const today = '{CST_TODAY}';
          this.form.from.value = today;
          this.form.to.value = today;
          this.form.showAll.checked = false;
          this.form.submit();
        "
      >
        Reset to Today
      </button>
    </form>
  </div>

  <div class="counts">
    Showing {visibleCount} of {totalCount} registrations
    for {fromDate} to {toDate}
    {showAll ? "(Show all enabled)" : "(Filtered by RFID / wristband rules)"}
  </div>

  <div class="table-container">
    <table>
      <thead>
        <tr>
          <th>Unit</th>
          <th>Arrival</th>
          <th>Departure</th>
          <th>Created At</th>
          <th>Guest</th>
          <th>Band Type</th>
          <th>RFID</th>
        </tr>
      </thead>

      <tbody>
        {filteredRows.map((row) => {
          const created = toCSTDateTime(row.createdAt);
          return (
			<tr>
			  <td>{row.unit}</td>
			  <td>{toCSTDate(row.arrivalDate)}</td>
			  <td>{toCSTDate(row.departureDate)}</td>
			  <td>{created.date} {created.time}</td>

			  <td>
				{row.passInfo_name === "Registration Fee"
				  ? `${row.guest_firstName} ${row.guest_lastName}`
				  : ""}
			  </td>

			  <td>
				{row.passInfo_name === "Registration Fee"
				  ? `Registration Fee (${row.paid || "unknown"})`
				  : row.passInfo_name}
			  </td>

			  <td>{row.externalCredentialNumber}</td>
			</tr>
          );
        })}

        {filteredRows.length === 0 && (
          <tr>
            <td colspan="7" style="text-align:center; padding: 15px;">
              No registrations found for the selected range.
            </td>
          </tr>
        )}
      </tbody>
    </table>
  </div>

</body>
</html>
