---
Astro.response.headers.set("Cache-Control", "no-cache, no-store, must-revalidate");
Astro.response.headers.set("Pragma", "no-cache");
Astro.response.headers.set("Expires", "0");

// Cloudflare D1 binding
const DB = (Astro.locals as any).runtime.env.DB;

// ============================================================
// CST Helpers
// ============================================================

function getCSTDate() {
  return new Date().toLocaleDateString("en-CA", {
    timeZone: "America/Chicago"
  });
}

const CST_TODAY = getCSTDate();

function toCSTDate(dateStr) {
  if (!dateStr) return "";
  if (/^\d{4}-\d{2}-\d{2}$/.test(dateStr)) return dateStr;
  return new Date(dateStr).toLocaleDateString("en-CA", {
    timeZone: "America/Chicago"
  });
}

function toCSTDateTime(dateStr) {
  if (!dateStr) return { date: "", time: "" };
  const d = new Date(dateStr);
  return {
    date: d.toLocaleDateString("en-CA", { timeZone: "America/Chicago" }),
    time: d.toLocaleTimeString("en-US", {
      timeZone: "America/Chicago",
      hour: "numeric",
      minute: "2-digit"
    })
  };
}

// ============================================================
// Read query params
// ============================================================

const url = new URL(Astro.request.url);
const fromParam = url.searchParams.get("from");
const toParam = url.searchParams.get("to");
const showAllParam = url.searchParams.get("showAll");

const showAll = showAllParam === "on" || showAllParam === "1";

const fromDateRaw = fromParam || CST_TODAY;
const toDateRaw   = toParam   || CST_TODAY;

const fromDate = toCSTDate(fromDateRaw);
const toDate   = toCSTDate(toDateRaw);

// ============================================================
// MODE 1: SHOW ALL (optimized)
// ============================================================

let filteredRows = [];

if (showAll) {

  // ------------------------------------------------------------
  // Query ONLY Registration Fee rows for guests CURRENTLY STAYING
  // arrivalDate <= TODAY AND departure > TODAY
  // ------------------------------------------------------------
  const feeRows = await DB.prepare(`
    SELECT
      passId,
      registrationId,
      unit,
      substr(arrivalDate, 1, 10) AS arrivalDate,
      substr(departure, 1, 10) AS departure,
      createdAt,
      guest_firstName,
      guest_lastName,
      passType,
      passInfo_name,
      externalCredentialNumber,
      paid
    FROM guest_reg
    WHERE passInfo_name = 'Registration Fee'
      AND substr(arrivalDate, 1, 10) <= ?
      AND substr(departure, 1, 10) > ?
    ORDER BY unit, registrationId
  `).bind(CST_TODAY, CST_TODAY).all();

  // ------------------------------------------------------------
  // For each registration, fetch wristbands (small query)
  // ------------------------------------------------------------
  for (const fee of feeRows.results || []) {

    const regId = fee.registrationId;

    const wbRows = await DB.prepare(`
      SELECT *
      FROM guest_reg
      WHERE registrationId = ?
        AND passInfo_name != 'Registration Fee'
    `).bind(regId).all();

    const wristbands = wbRows.results || [];

    // ------------------------------------------------------------
    // Determine completeness
    // ------------------------------------------------------------
    const feeRFID = (fee.externalCredentialNumber || "").trim() !== "";
    const wristRFID = wristbands.filter(w => (w.externalCredentialNumber || "").trim() !== "");
    const wristBlank = wristbands.filter(w => (w.externalCredentialNumber || "").trim() === "");

    const paid = fee.paid;
    const validFee = (paid === "paid" || paid === "ach-pending");
    const unpaidFee = (paid === "unpaid");

    let complete = false;

    if (validFee) {
      complete =
        feeRFID &&
        wristRFID.length === wristbands.length &&
        wristBlank.length === 0;
    }

    // ------------------------------------------------------------
    // Build ONE ROW per registration
    // ------------------------------------------------------------
    filteredRows.push({
      ...fee,
      registrationId: regId,
      isComplete: complete,
      isUnpaid: unpaidFee
    });
  }

} else {

  // ============================================================
  // MODE 2: NORMAL MODE (date filtered, full wristband logic)
  // ============================================================

  const rows = await DB.prepare(`
    SELECT
      passId,
      registrationId,
      unit,
      substr(arrivalDate, 1, 10) AS arrivalDate,
      substr(departure, 1, 10) AS departure,
      createdAt,
      guest_firstName,
      guest_lastName,
      passType,
      passInfo_name,
      externalCredentialNumber,
      paid
    FROM guest_reg
    WHERE substr(arrivalDate, 1, 10) >= ?
      AND substr(arrivalDate, 1, 10) <= ?
    ORDER BY arrivalDate, unit, createdAt
  `).bind(fromDate, toDate).all();

  // Grouping logic stays the same
  const grouped = new Map();

  for (const row of rows.results || []) {
    const unit = row.unit;
    const regId = row.registrationId;

    if (!grouped.has(unit)) grouped.set(unit, new Map());
    const regMap = grouped.get(unit);

    if (!regMap.has(regId)) {
      regMap.set(regId, { fee: null, wristbands: [] });
    }

    const group = regMap.get(regId);

    if (row.passInfo_name === "Registration Fee") {
      group.fee = row;
    } else {
      group.wristbands.push(row);
    }
  }

  // Build final rows (normal mode)
  for (const [unit, regMap] of grouped.entries()) {
    for (const [regId, group] of regMap.entries()) {
      const fee = group.fee;
      const wb = group.wristbands;

      if (!fee) continue;

      const paid = fee.paid;
      const validFee = (paid === "paid" || paid === "ach-pending");
      const unpaidFee = (paid === "unpaid");

      const feeRFID = (fee.externalCredentialNumber || "").trim() !== "";
      const wristRFID = wb.filter(w => (w.externalCredentialNumber || "").trim() !== "");
      const wristBlank = wb.filter(w => (w.externalCredentialNumber || "").trim() === "");

      let include = false;

      if (!showAll) {
        if (!validFee) {
          include = false;
        } else {
          const isComplete =
            feeRFID &&
            wristRFID.length === wb.length &&
            wristBlank.length === 0;

          include = !isComplete;
        }
      }

      if (!include) continue;

      filteredRows.push({
        ...fee,
        registrationId: regId,
        isComplete: false,
        isUnpaid: unpaidFee
      });

      for (const w of wb) {
        filteredRows.push({
          ...w,
          registrationId: regId,
          isComplete: false,
          isUnpaid: unpaidFee
        });
      }
    }
  }
}

const visibleCount = filteredRows.length;
const totalCount = filteredRows.length;
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Guest Registration Summary</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/x-icon" href="/favicon-circle-v3.ico">

  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: Arial, sans-serif;
      background: #0d1b2a;
      color: #ffffff;
    }

    .guest-banner {
      width: 100%;
      background: #1b263b;
      color: white;
      padding: 18px 25px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 4px solid #415a77;
    }

    .guest-banner-logo { height: 60px; }

    .guest-banner-title {
      font-size: 34px;
      font-weight: bold;
      white-space: nowrap;
      text-align: center;
    }

    .nav-btn, .logout-btn {
      width: 100%;
      text-align: center;
      padding: 10px 16px;
      border-radius: 6px;
      font-weight: bold;
      cursor: pointer;
      font-size: 14px;
      border: 2px solid #ffffff;
      background: transparent;
      color: #ffffff;
      transition: 0.2s;
    }

    .nav-btn:hover, .logout-btn:hover {
      background: #ffffff;
      color: #000000;
    }

    h2 {
      margin: 25px;
      font-size: 26px;
      color: #ffffff;
    }

    .top-bar {
      margin: 0 25px 20px 25px;
      background: #1b263b;
      padding: 15px;
      border-radius: 8px;
    }

    .btn-blue {
      background: #415a77;
      color: white;
      border: none;
      padding: 8px 14px;
      border-radius: 6px;
      cursor: pointer;
      margin-right: 8px;
      transition: 0.2s;
    }

    .btn-blue:hover { background: #778da9; }

    .counts {
      margin: 0 25px 10px 25px;
      font-size: 14px;
      color: #ffffff;
    }

    .table-container {
      margin: 0 25px 40px 25px;
      background: #1b263b;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.4);
      overflow: hidden;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 15px;
      color: #ffffff;
    }

    thead th {
      background: #415a77;
      color: white;
      padding: 12px 10px;
      border-right: 2px solid #778da9;
      font-weight: bold;
      text-align: left;
    }

    tbody td {
      padding: 10px;
      border-right: 1px solid #778da9;
      border-bottom: 1px solid #415a77;
    }

    tbody tr:nth-child(even) { background: #0d1b2a; }
    tbody tr:hover { background: #415a77; }

    .complete { background-color: #1e5631 !important; }
    .incomplete { background-color: #8b0000 !important; }
  </style>
</head>

<body>

  <div class="guest-banner">
    <div class="banner-left">
      <img src="/sop_logo.jpg" class="guest-banner-logo" />
    </div>

    <div class="banner-center">
      <div class="guest-banner-title">Guest Reservations</div>
    </div>

    <div class="banner-right">
      <button class="nav-btn" onclick="window.location.href='/status'">
        Return to Status
      </button>

      <button class="logout-btn" onclick="
        document.cookie = 'sop_auth=; Max-Age=0; path=/';
        window.location.href='https://www.google.com/';
      ">
        Logout
      </button>
    </div>
  </div>

  <h2>Guest Registration Summary</h2>

  <div class="top-bar">
    <form class="left-controls" method="GET">
      <label>From:</label>
      <input type="date" name="from" value={fromDate} />

      <label>To:</label>
      <input type="date" name="to" value={toDate} />

      <input type="checkbox" name="showAll" checked={showAll} />
      <label>Show all</label>

      <button type="submit" class="btn-blue">Search</button>
      <button type="submit" class="btn-blue">Refresh</button>

      <button
        type="button"
        class="btn-blue"
        onclick="
          const today = '{CST_TODAY}';
          this.form.from.value = today;
          this.form.to.value = today;
          this.form.showAll.checked = false;
          this.form.submit();
        "
      >
        Reset to Today
      </button>
    </form>
  </div>

  <div class="counts">
    Showing {visibleCount} registrations
    {showAll ? "(Currently staying — Show All mode)" : "(Filtered by date range)"}
  </div>

  <div class="table-container">
    <table>
      <thead>
        <tr>
          <th>Unit</th>
          <th>Arrival</th>
          <th>Departure</th>
          <th>Created At</th>
          <th>Guest</th>
          <th>Status</th>
          <th>RFID</th>
        </tr>
      </thead>

      <tbody>
        {filteredRows.map((row) => {
          const created = toCSTDateTime(row.createdAt);

          const rowClass = row.isComplete
            ? "complete"
            : "incomplete";

          return (
            <tr class={rowClass}>
              <td>{row.unit}</td>
              <td>{toCSTDate(row.arrivalDate)}</td>
              <td>{toCSTDate(row.departure)}</td>
              <td>{created.date} {created.time}</td>

              <td>{`${row.guest_firstName} ${row.guest_lastName}`}</td>

              <td>
                {row.isComplete
                  ? "Complete"
                  : row.isUnpaid
                    ? "Unpaid"
                    : "Incomplete"}
              </td>

              <td>{row.externalCredentialNumber}</td>
            </tr>
          );
        })}

        {filteredRows.length === 0 && (
          <tr>
            <td colspan="7" style="text-align:center; padding: 15px;">
              No registrations found.
            </td>
          </tr>
        )}
      </tbody>
    </table>
  </div>

</body>
</html>
